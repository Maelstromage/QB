
CLS
R2D:
RANDOMIZE TIMER
SCRN = INT(RND * 5) + 1
IF SCRN = 2 THEN GOTO CIRLE
IF SCRN = 1 THEN GOTO DESIGN
IF SCRN = 3 THEN GOTO BOUNCE
IF SCRN = 4 THEN GOTO LINEFOLLO
IF SCRN = 5 THEN GOTO LINESPLAT
GOTO R2D
NIT:
CLS
R = 0
S = 1
DESIGN:
SCREEN 12
CCHANGE = 1
RCHANGE = 1
C = 5
CLS
D = 50
DO

CIRCLE (C, R), D + 1, 0
CIRCLE (C, R), D, V
RANDOMIZE TIMER
D = D - 1

IF D = 5 THEN D = 50
V = INT(RND * 14)
C = C + CCHANGE
R = R + RCHANGE
IF C > 640 THEN CCHANGE = INT(RND * -5)
IF R > 480 THEN RCHANGE = INT(RND * -5)
IF C < 0 THEN CCHANGE = INT(RND * 5)
IF R < 0 THEN RCHANGE = INT(RND * 5)
key$ = INKEY$
IF key$ <> "" THEN SYSTEM
       
LOOP

CIRLE:

RANDOMIZE TIMER
R = 0
S = 1
TI:
R = 0
CLS
DO
IT:
SCREEN 12
R = R + 1
IF S = 1 THEN GOSUB RZ
CIRCLE (Y2, X1), R, 1
IF S = 1 THEN GOSUB RN
CIRCLE (Y1, X2), R, 2
IF S = 1 THEN GOSUB RF
CIRCLE (F2, F1), R, 4
IF S = 1 THEN GOSUB RG
CIRCLE (G2, G1), R, 5
IF S = 1 THEN GOSUB RH
CIRCLE (H2, H1), R, 3
IF S = 1 THEN GOSUB RJ
CIRCLE (J2, J1), R, 14
IF S = 1 THEN GOSUB RK
CIRCLE (K2, K1), R, 12
IF R >= 250 THEN GOTO TI
key$ = INKEY$
IF key$ <> "" THEN SYSTEM

LOOP

GOTO IT
RZ:
X1 = INT(RND * 460) + 1
Y2 = INT(RND * 639) + 1
RETURN
RF:
F1 = INT(RND * 460) + 1
F2 = INT(RND * 639) + 1
'Y2 = Y1 + 7
RETURN
RG:
G1 = INT(RND * 460) + 1
G2 = INT(RND * 639) + 1
'Y2 = Y1 + 7
RETURN
RH:
H1 = INT(RND * 460) + 1
H2 = INT(RND * 639) + 1
'Y2 = Y1 + 7
RETURN
RJ:
J1 = INT(RND * 460) + 1
J2 = INT(RND * 639) + 1
'2 = Y1 + 7
RETURN
RK:
K1 = INT(RND * 460) + 1
K2 = INT(RND * 639) + 1
S = 2
'2 = Y1 + 7
RETURN
RL:
L1 = INT(RND * 460) + 1
L1 = INT(RND * 639) + 1
'Y2 = Y1 + 7
S = 2
RETURN
RN:
X2 = INT(RND * 460) + 1
Y1 = INT(RND * 639) + 1
RETURN

BOUNCE:
SCREEN 12
CHANGE = 3
RCHANGE = 2
X2 = 5
Y2 = 1
A2 = 3
B2 = 4
V2 = 5
N2 = 1
G2 = 1
H2 = 2
E2 = 4
D2 = 5
CLS
DO
RANDOMIZE TIMER
C = C + CHANGE
R = R + RCHANGE
X = X + X2
y = y + Y2
A = A + A2
B = B + B2
V = V + V2
N = N + N2
G = G + G2
H = H + H2
E = E + E2
D = D + D2
LINE (C, R)-(X, y), 1
LINE (A, B)-(X, y), 1
LINE (A, B)-(C, R), 1
FOR N = 1 TO 100
NEXT N
LINE (C, R)-(X, y), 0
LINE (X, y)-(A, B), 0
LINE (A, B)-(C, R), 0
LINE (V, N)-(G, H), 2
LINE (G, H)-(E, D), 2
LINE (E, D)-(V, N), 2
FOR N = 1 TO 100
NEXT N
LINE (V, N)-(G, H), 0
LINE (G, H)-(E, D), 0
LINE (E, D)-(V, N), 0
IF V < 0 THEN V2 = INT(RND * 9)
IF N < 0 THEN N2 = INT(RND * 9)
IF N > 470 THEN N2 = INT(RND * -9)
IF V > 630 THEN V2 = INT(RND * -9)
IF G < 0 THEN G2 = INT(RND * 9)
IF H < 0 THEN H2 = INT(RND * 9)
IF G > 630 THEN G2 = INT(RND * -9)
IF H > 470 THEN H2 = INT(RND * -9)
IF E < 0 THEN E2 = INT(RND * 9)
IF D < 0 THEN D2 = INT(RND * 9)
IF E > 630 THEN E2 = INT(RND * -9)
IF D > 470 THEN D2 = INT(RND * -9)
IF C < 0 THEN CHANGE = INT(RND * 9)
IF R < 0 THEN RCHANGE = INT(RND * 9)
IF R > 470 THEN RCHANGE = INT(RND * -9)
IF C > 630 THEN CHANGE = INT(RND * -9)
IF X < 0 THEN X2 = INT(RND * 9)
IF y < 0 THEN Y2 = INT(RND * 9)
IF X > 630 THEN X2 = INT(RND * -9)
IF y > 470 THEN Y2 = INT(RND * -9)
IF A < 0 THEN A2 = INT(RND * 9)
IF B < 0 THEN B2 = INT(RND * 9)
IF A > 630 THEN A2 = INT(RND * -9)
IF B > 470 THEN B2 = INT(RND * -9)
key$ = INKEY$
IF key$ <> "" THEN SYSTEM


LOOP


LINEFOLLO:
SCREEN 11
RANDOMIZE TIMER
LINES = 0
A = RND * 639
B = RND * 470
DO
FOR N = 1 TO 200
NEXT N
D = D + 1
X = RND * 639

y = RND * 470
LINE (A, B)-(X, y), C
A = X
B = y
IF D = 50 THEN CLS
IF D = 50 THEN D = 1
IF D = 1 THEN C = C + 1
IF C = 14 THEN C = 1
key$ = INKEY$
IF key$ <> "" THEN SYSTEM


LOOP

LINESPLAT:
SCREEN 11
RANDOMIZE TIMER
LINES = 0
A = RND * 639
B = RND * 470
DO
FOR N = 1 TO 100
NEXT N
RANDOMIZE TIMER
D = D + 1
X = RND * 639
y = RND * 470

LINE (A, B)-(X, y), C
X = A
y = B
IF D = 100 THEN CLS
IF D = 100 THEN D = 1
IF D = 1 THEN A = RND * 639: B = RND * 470
IF D = 1 THEN C = C + 1
IF C = 14 THEN C = 1
key$ = INKEY$
IF key$ <> "" THEN SYSTEM


LOOP


