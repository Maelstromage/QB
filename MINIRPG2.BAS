SUB MENUUPDATE (P)

 SCREEN , , BTLPAGE, VISPAGE
 GET (230 + 30 * (P = 1), 170)-(256 + 30 * (P = 1), 177), FMV
 SCREEN , , VISPAGE, VISPAGE: PUT (MAPOUTX + 3, MAPOUTY + 9), FMV, PSET
 SCREEN , , BTLPAGE, VISPAGE
 GET (230 + 30 * (P = 2), 179)-(256 + 30 * (P = 2), 186), FMV
 SCREEN , , VISPAGE, VISPAGE: PUT (MAPOUTX + 3, MAPOUTY + 23), FMV, PSET
 SCREEN , , BTLPAGE, VISPAGE
 GET (230 + 30 * (P = 3), 188)-(256 + 30 * (P = 3), 195), FMV
 SCREEN , , VISPAGE, VISPAGE: PUT (MAPOUTX + 3, MAPOUTY + 37), FMV, PSET

END SUB

