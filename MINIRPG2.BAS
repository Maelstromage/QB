 LOADSCREEN "3PAGE", 3
 LOADSCREEN "4PAGE", 4
 LOADSCREEN "5PAGE", 5
 LOADSCREEN "6PAGE", 6
 LOADSCREEN "7PAGE", 7

 '--- check saved file ---
 INITFILE

 DELAY 10

END SUB

