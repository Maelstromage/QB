 DRAW "BM" + STR$(BTLOUTX + 0) + "," + STR$(BTLOUTY)
 DRAW "C1BR5BDR110FRFDFD11GDGLGL110HLHUHU11EUEREBFP15,1"

 SELECT CASE P1
