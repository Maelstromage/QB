     FOR J = 1 TO 9 \ 3
       GET (BTLOUTX + 5, BTLOUTY + 4)-(BTLOUTX + 115, BTLOUTY + 19), FMV
       PUT (BTLOUTX + 5, BTLOUTY + 3), FMV, PSET
       GET (BTLOUTX + 5, BTLOUTY + 4)-(BTLOUTX + 115, BTLOUTY + 19), FMV
       PUT (BTLOUTX + 5, BTLOUTY + 3), FMV, PSET
       GET (BTLOUTX + 5, BTLOUTY + 4)-(BTLOUTX + 115, BTLOUTY + 19), FMV
       PUT (BTLOUTX + 5, BTLOUTY + 3), FMV, PSET
       DELAY 1
     NEXT
     FOR I = 1 TO LEN(TALK3$(P2))
       DRAWNEWFONT BTLOUTX + 5, BTLOUTY + 12, TALKC(P2), &H0, 2, LEFT$(TALK3$(P2), I)
       DELAY 1
     NEXT
   END IF
 END SELECT

 DELAY 10

 FOR J = 1 TO 18 \ 3
   GET (BTLOUTX + 5, BTLOUTY + 4)-(BTLOUTX + 115, BTLOUTY + 19), FMV
   PUT (BTLOUTX + 5, BTLOUTY + 3), FMV, PSET
   GET (BTLOUTX + 5, BTLOUTY + 4)-(BTLOUTX + 115, BTLOUTY + 19), FMV
   PUT (BTLOUTX + 5, BTLOUTY + 3), FMV, PSET
   GET (BTLOUTX + 5, BTLOUTY + 4)-(BTLOUTX + 115, BTLOUTY + 19), FMV
   PUT (BTLOUTX + 5, BTLOUTY + 3), FMV, PSET
   DELAY 1
 NEXT

 DELAY 5

 LINE (BTLOUTX, BTLOUTY)-(BTLOUTX + 120, BTLOUTY + 20), 14, BF
 SELECT CASE P1
 CASE IS = 1
   DRAW "BM" + STR$(BTLOUTX + 57) + "," + STR$(BTLOUTY - 1)
   DRAW "C1R6BHC15L4BUC0R4HL2UR2BHC15U"
 CASE IS = 2: LINE (BTLOUTX + 24, BTLOUTY + 21)-(BTLOUTX + 34, BTLOUTY + 28), 14, BF
 CASE IS = 3: LINE (BTLOUTX + 86, BTLOUTY + 21)-(BTLOUTX + 96, BTLOUTY + 28), 14, BF
 END SELECT

 DELAY 5

END SUB

