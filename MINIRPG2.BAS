SUB DEMO1

 '- walk -
 SCREEN , , MAPPAGE, VISPAGE

 QUIT = FALSE
 FLOWER = FALSE
 FIRSTBATTLE = TRUE
 MAPROMX = 221
 MAPROMY = 68
 MAPSX = 0
 MAPSY = 64
 MAPRX = 4
 MAPRY = 16
 MV = 3

 BTLMAXHP(0) = 10 + INT(RND(1) * 150) + 1
 BTLHP(0) = INT(RND(1) * BTLMAXHP(0)) + 1
 BTLSTR(0) = INT(RND(1) * 50) + 1
 BTLDEF(0) = INT(RND(1) * 50) + 1
 BTLLUCK(0) = INT(RND(1) * 50) + 1
 BTLEVADE(0) = INT(RND(1) * 30) + 1
 BTLSPD(0) = INT(RND(1) * 99) + 1

 MAPOFF
 MAPON

 MAPROMRUNV = 0
 MAPROMRUNP$ = ""

 MAPROMRUNP$ = MAPROMRUNP$ + " M M M H H M M H H H M"
 MAPROMRUNP$ = MAPROMRUNP$ + " M M M H M H M M M H H H"

 MAPROMRUNZ = LEN(MAPROMRUNP$)

 SCREEN , , MAPPAGE, VISPAGE

 WHILE INKEY$ <> "": WEND

 DO
   A$ = UCASE$(INKEY$): A = RND(1)
   IF LEN(A$) = 2 THEN A$ = "*" + RIGHT$(A$, 1)

   IF WALK = 0 THEN
     MAPROMRUNV = MAPROMRUNV + 1 + (MAPROMRUNV = MAPROMRUNZ)
     IF (MAPROMRUNV >= MAPROMRUNZ) THEN QUIT = TRUE
     A$ = "*" + MID$(MAPROMRUNP$, MAPROMRUNV + 1, 1)
   END IF

   IF A$ = "*K" AND WALK = 0 THEN MV = 0: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRX = MAPRX - 1 - (MAPRX = 1): SE 4
   IF A$ = "*M" AND WALK = 0 THEN MV = 3: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRX = MAPRX + 1 + (MAPRX = 24): SE 4
   IF A$ = "*P" AND WALK = 0 THEN MV = 1: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRY = MAPRY + 1 + (MAPRY = 16): SE 4
   IF A$ = "*H" AND WALK = 0 THEN MV = 2: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRY = MAPRY - 1 - (MAPRY = 1): SE 4

   IF WALK <> 0 THEN
     WALK = WALK - 1
     IF WALK = 0 THEN GROUND = MAPAREA(MAPRX, MAPRY): CHECK = TRUE
     v = v + WALKSPEED
     IF v >= 16 THEN v = 0

     SELECT CASE MV
     CASE IS = 0
       IF MAPROMX > 229 OR MAPSX <= 0 THEN
          MAPROMX = MAPROMX - WALKSPEED
          IF MAPROMX <= 197 THEN MAPROMX = 197
       ELSE
          MAPSX = MAPSX - WALKSPEED
          IF MAPSX <= 0 THEN MAPSX = 0
       END IF
     CASE IS = 1
       IF MAPROMY <= 43 OR MAPSY >= 64 THEN
         MAPROMY = MAPROMY + WALKSPEED
         IF MAPROMY >= 68 THEN MAPROMY = 68
       ELSE
         MAPSY = MAPSY + WALKSPEED
         IF MAPSY >= 64 THEN MAPSY = 64
       END IF
     CASE IS = 2
       IF MAPROMY > 44 OR MAPSY <= 0 THEN
         MAPROMY = MAPROMY - WALKSPEED
         IF MAPROMY <= 12 THEN MAPROMY = 12
       ELSE
         MAPSY = MAPSY - WALKSPEED
         IF MAPSY <= 0 THEN MAPSY = 0
       END IF
     CASE IS = 3
       IF MAPROMX <= 228 OR MAPSX >= 112 THEN
         MAPROMX = MAPROMX + WALKSPEED
         IF MAPROMX >= 269 THEN MAPROMX = 269
       ELSE
         MAPSX = MAPSX + WALKSPEED
         IF MAPSX >= 112 THEN MAPSX = 112
       END IF
     END SELECT
   END IF

   SCREEN , , MAPPAGE, VISPAGE
   GET (MAPSX, MAPSY)-(MAPSX + 79, MAPSY + 79), FMV
   PUT (200, 10), FMV, PSET

   IF BATTLERESULT <> 3 THEN TPSETROM MAPROMX, MAPROMY, MV * 3 + VAL(MID$("0011111100222222", v + 1, 1))

   GET (200, 10)-(279, 89), FMV
   SCREEN , , VISPAGE, VISPAGE
   PUT (MAPOUTX, MAPOUTY), FMV, PSET
   SCREEN , , MAPPAGE, VISPAGE

   IF CHECK = TRUE THEN
     CHECK = FALSE
     IF GROUND = 5 THEN CHECKEVENT
   END IF

   DELAY 1

 LOOP UNTIL QUIT

 MAPOFF

 '- battle -
 LINE (MAPOUTX - 2, MAPOUTY - 2)-(MAPOUTX + 81, MAPOUTY + 81), 0, BF
 ENEMYNUM = (ENEMYNUM MOD 2) + 1
 EVENT = 0
 DEMO = TRUE

 BTLON
 BATTLE
 BTLOFF

 DEMO = FALSE

 '- walk -
 SCREEN , , MAPPAGE, VISPAGE
 FIRSTBATTLE = TRUE
 QUIT = FALSE
 MAPON

 MAPROMRUNV = 0
 MAPROMRUNP$ = "KKKKKKPPPKKPKKKKKKPPKPPP"
 MAPROMRUNP$ = MAPROMRUNP$ + "                        "
 MAPROMRUNP$ = MAPROMRUNP$ + "HHHHKKPPMMMMMPMM"

 MAPROMRUNZ = LEN(MAPROMRUNP$)

 SCREEN , , MAPPAGE, VISPAGE

 WHILE INKEY$ <> "": WEND

 DO
   A$ = UCASE$(INKEY$): A = RND(1)
   IF LEN(A$) = 2 THEN A$ = "*" + RIGHT$(A$, 1)

   IF WALK = 0 THEN
     MAPROMRUNV = MAPROMRUNV + 1 + (MAPROMRUNV = MAPROMRUNZ)
     IF (MAPROMRUNV >= MAPROMRUNZ) THEN QUIT = TRUE
     A$ = "*" + MID$(MAPROMRUNP$, MAPROMRUNV + 1, 1)
   END IF

   IF A$ = "*K" AND WALK = 0 THEN MV = 0: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRX = MAPRX - 1 - (MAPRX = 1): SE 4
   IF A$ = "*M" AND WALK = 0 THEN MV = 3: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRX = MAPRX + 1 + (MAPRX = 24): SE 4
   IF A$ = "*P" AND WALK = 0 THEN MV = 1: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRY = MAPRY + 1 + (MAPRY = 16): SE 4
   IF A$ = "*H" AND WALK = 0 THEN MV = 2: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRY = MAPRY - 1 - (MAPRY = 1): SE 4

   IF WALK <> 0 THEN
     WALK = WALK - 1
     IF WALK = 0 THEN GROUND = MAPAREA(MAPRX, MAPRY): CHECK = TRUE
     v = v + WALKSPEED
     IF v >= 16 THEN v = 0
     SELECT CASE MV
     CASE IS = 0
       IF MAPROMX > 229 OR MAPSX <= 0 THEN
         MAPROMX = MAPROMX - WALKSPEED
         IF MAPROMX <= 197 THEN MAPROMX = 197
       ELSE
         MAPSX = MAPSX - WALKSPEED
         IF MAPSX <= 0 THEN MAPSX = 0
       END IF
     CASE IS = 1
       IF MAPROMY <= 43 OR MAPSY >= 64 THEN
         MAPROMY = MAPROMY + WALKSPEED
         IF MAPROMY >= 68 THEN MAPROMY = 68
       ELSE
         MAPSY = MAPSY + WALKSPEED
         IF MAPSY >= 64 THEN MAPSY = 64
       END IF
     CASE IS = 2
       IF MAPROMY > 44 OR MAPSY <= 0 THEN
         MAPROMY = MAPROMY - WALKSPEED
         IF MAPROMY <= 12 THEN MAPROMY = 12
       ELSE
         MAPSY = MAPSY - WALKSPEED
         IF MAPSY <= 0 THEN MAPSY = 0
       END IF
     CASE IS = 3
       IF MAPROMX <= 228 OR MAPSX >= 112 THEN
         MAPROMX = MAPROMX + WALKSPEED
         IF MAPROMX >= 269 THEN MAPROMX = 269
       ELSE
         MAPSX = MAPSX + WALKSPEED
         IF MAPSX >= 112 THEN MAPSX = 112
       END IF
     END SELECT
   END IF

   SCREEN , , MAPPAGE, VISPAGE
   GET (MAPSX, MAPSY)-(MAPSX + 79, MAPSY + 79), FMV
   PUT (200, 10), FMV, PSET

   IF BATTLERESULT <> 3 THEN TPSETROM MAPROMX, MAPROMY, MV * 3 + VAL(MID$("0011111100222222", v + 1, 1))

   GET (200, 10)-(279, 89), FMV
   SCREEN , , VISPAGE, VISPAGE
   PUT (MAPOUTX, MAPOUTY), FMV, PSET
   SCREEN , , MAPPAGE, VISPAGE

   IF CHECK = TRUE THEN
     CHECK = FALSE
     IF GROUND >= 5 THEN CHECKEVENT
   END IF

   DELAY 1

 LOOP UNTIL QUIT

 SCREEN , , VISPAGE, VISPAGE
 DRAW "C0"

 FOR I = 0 TO 79 STEP 2
   DRAW "BM" + STR$(MAPOUTX + 0) + "," + STR$(MAPOUTY + I)
   FOR J = 1 TO 20: DRAW "R0BR2R0BR2": NEXT
 NEXT

 FOR I = 0 TO 79 STEP 2
   DRAW "BM" + STR$(MAPOUTX + 1) + "," + STR$(MAPOUTY + 1 + I)
   FOR J = 1 TO 20: DRAW "R0BR2R0BR2": NEXT
 NEXT

 FOR I = 0 TO 79 STEP 2
   DRAW "BM" + STR$(MAPOUTX + 1) + "," + STR$(MAPOUTY + I)
   FOR J = 1 TO 20: DRAW "R0BR2R0BR2": NEXT
 NEXT

 FOR I = 0 TO 79 STEP 2
   DRAW "BM" + STR$(MAPOUTX + 0) + "," + STR$(MAPOUTY + 1 + I)
   FOR J = 1 TO 20: DRAW "R0BR2R0BR2": NEXT
 NEXT

 LINE (MAPOUTX - 2, MAPOUTY - 2)-(MAPOUTX + 81, MAPOUTY + 81), 0, BF

 FOR I = 38 TO 105: LINE (I, 18)-(I, 101), 0, BF: NEXT

 DELAY 2

 TITLEMENUUPDATE 5

END SUB

