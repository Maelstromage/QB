SUB FADE (P)

 FADESTEP = (8 \ 1) - 1
 SELECT CASE P
 CASE IS = 0   '- fade color to black -
   FOR J = 0 TO FADESTEP
     OUT &H3C8, 0
     FOR I = 0 TO 23
       VALUE1 = VAL(MID$("250009270918451800000000000000006363545509544563", I * 2 + 1, 2))
       OUT &H3C9, VALUE1 - (VALUE1 / FADESTEP * J)
       VALUE1 = VAL(MID$("260054630927095400000000000000000921545436184563", I * 2 + 1, 2))
       OUT &H3C9, VALUE1 - (VALUE1 / FADESTEP * J)
       VALUE1 = VAL(MID$("270009276363096300000000000000000921093609454563", I * 2 + 1, 2))
       OUT &H3C9, VALUE1 - (VALUE1 / FADESTEP * J)
     NEXT
     DELAY (1)
   NEXT

 CASE IS = 1   '- fade black to color -
   FOR J = FADESTEP TO 0 STEP -1
     OUT &H3C8, 0
     FOR I = 0 TO 23
       VALUE1 = VAL(MID$("250009270918451800000000000000006363545509544563", I * 2 + 1, 2))
       OUT &H3C9, VALUE1 - (VALUE1 / FADESTEP * J)
       VALUE1 = VAL(MID$("260054630927095400000000000000000921545436184563", I * 2 + 1, 2))
       OUT &H3C9, VALUE1 - (VALUE1 / FADESTEP * J)
       VALUE1 = VAL(MID$("270009276363096300000000000000000921093609454563", I * 2 + 1, 2))
       OUT &H3C9, VALUE1 - (VALUE1 / FADESTEP * J)
     NEXT
     DELAY (1)
   NEXT
 END SELECT

END SUB

SUB INITFILE

 PRINT "CHECK SAVED FILE"
 OPEN "SAVEDATA.REC" FOR APPEND AS #1:
   FILESIZE = LOF(1)
 CLOSE #1

 IF FILESIZE = 0 THEN
   EVENT = 0
   EX = 1
   ROUND = 0
   LEVEL = 1
   FLOWER = FALSE
   MAPROMX = 221
   MAPROMY = 68
   MAPSX = 0
   MAPSY = 64
   MAPRX = 4
   MAPRY = 16
   MV = 3
   BTLMAXHP(0) = MAXHITPOINT(0)
   BTLHP(0) = MAXHITPOINT(0)
   BTLSTR(0) = STRENGTH(0)
   BTLDEF(0) = DEFENSE(0)
   BTLLUCK(0) = LUCK(0)
   BTLEVADE(0) = EVADE(0)
   BTLSPD(0) = SPEED(0)

   OPEN "SAVEDATA.REC" FOR OUTPUT AS #1
     PRINT #1, "EVENT NUMBER       (0 TO 11)         -> ,"; EVENT
     PRINT #1, "CURRENT EXPERIENCE (0 TO 9)          -> ,"; EX
     PRINT #1, "BATTLE ROUND       (1 TO 1000)       -> ,"; ROUND
     PRINT #1, "LEVEL              (1 TO 1000)       -> ,"; LEVEL
     PRINT #1, "FLOWER         (0=HAVE / 1=DON'T)    -> ,"; FLOWER + 1
     PRINT #1, "ROM X POSITION (MAP) *do not change* -> ,"; MAPROMX
     PRINT #1, "ROM Y POSITION (MAP) *do not change* -> ,"; MAPROMY
     PRINT #1, "MAP X POSITION       *do not change* -> ,"; MAPSX
     PRINT #1, "MAP Y POSITION       *do not change* -> ,"; MAPSY
     PRINT #1, "ROM X POSITION       *do not change* -> ,"; MAPRX
     PRINT #1, "ROM Y POSITION       *do not change* -> ,"; MAPRY
     PRINT #1, "ROM'S DIRECTION      *do not change* -> ,"; MV
     PRINT #1, "MAX HP     (0 TO 500)                -> ,"; BTLMAXHP(0)
     PRINT #1, "CURRENT HP (0 TO MAX HP)             -> ,"; BTLHP(0)
     PRINT #1, "STRENGTH   (0 TO 50)                 -> ,"; BTLSTR(0)
     PRINT #1, "DEFENCE    (0 TO 50)                 -> ,"; BTLDEF(0)
     PRINT #1, "LUCK       (0 TO 50)                 -> ,"; BTLLUCK(0)
     PRINT #1, "EVADE      (0 TO 30)                 -> ,"; BTLEVADE(0)
     PRINT #1, "SPEED      (0 TO 99)                 -> ,"; BTLSPD(0)
   CLOSE #1
 END IF

END SUB

SUB INITIALIZE

 SCREEN 7

 '--- initialize some variables ---
 PLAY "MB"
 DRAW "A0S4"
 DEBUG = FALSE
 DEMO = FALSE
 IF DEMO THEN DEBUG = FALSE
 WALKSPEED = 2
 SOUNDOFF = TRUE
 DELAY 1
 QUIT = FALSE

 '--- load NEW color data ---
 PRINT "LOAD COLOR DATA ": BEEEP
 OPEN "NEWCOLOR.---" FOR INPUT AS #1
 FOR I = 1 TO 72: INPUT #1, COLORDATA(I): NEXT
 CLOSE #1

 '--- change color ---
 PRINT "CHANGE COLOR": BEEEP
 NEWCOLOR

 '--- load map data ---
 PRINT "LOAD MAP DATA ": BEEEP
 OPEN "MAPDATA.---" FOR INPUT AS #1
 FOR I = 0 TO 18: FOR J = 0 TO 25: INPUT #1, MAPAREA(J, I): NEXT: NEXT
 CLOSE #1

 '--- load animation pattern data ---
 PRINT "LOAD ANIMATION PATTERN DATA ": BEEEP
 OPEN "FRAMEPTN.---" FOR INPUT AS #1
 FOR Z = 1 TO 65: FOR I = 0 TO 25: INPUT #1, AMLAMR(I, Z): NEXT: NEXT
 CLOSE #1

 '--- load font data ---
 PRINT "LOAD NEWFONT(#32 - #126) DATA ": BEEEP
 OPEN "NEWFONT.---" FOR INPUT AS #1
 FOR I = 32 TO 126: LINE INPUT #1, NEWFONT$(I): NEXT
 CLOSE #1

 '--- load battle menu data ---
 PRINT "LOAD BATTLE MENU DATA ": BEEEP
 OPEN "BTLMENU.---" FOR INPUT AS #1
 FOR I = 0 TO 8: FOR J = 0 TO 3: LINE INPUT #1, BTLMENU$(I, J): NEXT: NEXT
 CLOSE #1

 '--- load status ---
 PRINT "LOAD STATUS DATA ": BEEEP
 OPEN "STATUS.---" FOR INPUT AS #1
 FOR I = 0 TO 8
   INPUT #1, MAXHITPOINT(I), STRENGTH(I), DEFENSE(I)
   INPUT #1, LUCK(I), EVADE(I), SPEED(I), EXPPTS(I)
 NEXT
 CLOSE #1

 '--- load small object X & Y data ---
 PRINT "LOAD OBJECT X & Y DATA": BEEEP
 OPEN "OBJ-X&Y.---" FOR INPUT AS #1
 FOR I = 1 TO 36: INPUT #1, OBJX(I), OBJY(I), OBJWID(I), OBJHGT(I): NEXT
 CLOSE

 '--- load TALK data ---
 PRINT "LOAD TALK DATA": BEEEP
 OPEN "TALK.---" FOR INPUT AS #1
 FOR I = 1 TO 54
   INPUT #1, TALKC(I): LINE INPUT #1, TALK1$(I)
   LINE INPUT #1, TALK2$(I): LINE INPUT #1, TALK3$(I):
 NEXT
 CLOSE

 '--- load 1-7 page ---
 PRINT "LOAD GRAPHICS": BEEEP
 LOADSCREEN "1PAGE", 1
