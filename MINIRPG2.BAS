   DRAW "BM" + STR$(BTLOUTX + 56) + "," + STR$(BTLOUTY + 1)
   DRAW "C1EUEUEUENUFDFDFDFBLC15L6ER4UL4ER2UL2EU"
 CASE IS = 2
   DRAW "BM" + STR$(BTLOUTX + 60 - 25) + "," + STR$(BTLOUTY + 20)
   DRAW "C1G3LG2LG2LNGUEUEU2HBRC15R7GL5DNR4DR2GL2DG"
 CASE IS = 3
   DRAW "BM" + STR$(BTLOUTX + 60 + 25) + "," + STR$(BTLOUTY + 20)
   DRAW "C1F3RF2RF2RNFUHUHU2EBLC15L7FR5DNL4DL2FR2DF"
 END SELECT

 DELAY 5

 T1$ = "": T2$ = ""
 SELECT CASE P2
 CASE IS = 0
   SELECT CASE P3
   CASE IS = 0
     IF P4 <= 999 THEN
       T1$ = "  ROUND " + RIGHT$("   " + LTRIM$(STR$(P4)), 3)
     ELSE
       T1$ = "  ROUND 999+"
     END IF
     T2$ = "     FIGHT    "
   CASE IS = 1:
     T1$ = "   LEVEL UP   "
     IF P4 <= 999 THEN
       T2$ = "    Lv." + RIGHT$("   " + LTRIM$(STR$(P4)), 3)
     ELSE
       T2$ = "    Lv. 999+"
     END IF
   CASE IS = 2
     T1$ = "   MAX HP +" + RIGHT$("  " + LTRIM$(STR$(P4)), 2)
   CASE IS = 3
     T1$ = "    STR +" + RIGHT$(" " + LTRIM$(STR$(P4)), 1)
   CASE IS = 4
     T1$ = "    DEF +" + RIGHT$(" " + LTRIM$(STR$(P4)), 1)
   CASE IS = 5
     T1$ = "    LUCK +" + RIGHT$(" " + LTRIM$(STR$(P4)), 1)
   CASE IS = 6
     T1$ = "   EVADE +" + RIGHT$(" " + LTRIM$(STR$(P4)), 1)
   CASE IS = 7
