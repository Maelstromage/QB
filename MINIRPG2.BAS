SUB DAMAGEUPDATE (P, DM)

 IF P = 1 THEN
   FOR I = 1 TO DM
     BTLHP(1) = BTLHP(1) - 1
     UPDATEHPBAR 1, BTLHP(1)
     DRAWNEWFONT 250, 21, 1, 15, 2, RIGHT$("   " + LTRIM$(STR$(BTLHP(1))), 3)
   NEXT
 ELSE
   FOR I = 1 TO DM
     BTLHP(0) = BTLHP(0) - 1
     UPDATEHPBAR 0, BTLHP(0)
     DRAWNEWFONT 53, 21, 1, 15, 2, RIGHT$("   " + LTRIM$(STR$(BTLHP(0))), 3)
   NEXT
 END IF

END SUB

SUB DELAY (P)

 STATIC OLDSPEED!
 FOR I = 1 TO P
   DO
     SPEED! = TIMER
   LOOP UNTIL SPEED! <> OLDSPEED!
   OLDSPEED! = SPEED!
 NEXT

END SUB

