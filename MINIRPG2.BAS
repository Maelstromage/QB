SUB TITLEMENUUPDATE (P)

 IF P <> 6 THEN
   X = 19: Y = 38
   SCREEN , , BTLPAGE, VISPAGE
   GET (240 + 44 * (P = 1), 10)-(281 + 44 * (P = 1), 17), FMV
   SCREEN , , VISPAGE, VISPAGE: PUT (MAPOUTX + X, MAPOUTY + Y), FMV, PSET
   SCREEN , , BTLPAGE, VISPAGE
   GET (240 + 44 * (P = 2), 19)-(281 + 44 * (P = 2), 26), FMV
   SCREEN , , VISPAGE, VISPAGE: PUT (MAPOUTX + X, MAPOUTY + Y + 10), FMV, PSET
   SCREEN , , BTLPAGE, VISPAGE
   IF DEBUG THEN
      GET (240 + 44 * (P = 3), 28)-(281 + 44 * (P = 3), 35), FMV
   ELSE
      GET (240 + 44 * (P = 3), 46)-(281 + 44 * (P = 3), 53), FMV
   END IF
   SCREEN , , VISPAGE, VISPAGE: PUT (MAPOUTX + X, MAPOUTY + Y + 20), FMV, PSET
   SCREEN , , BTLPAGE, VISPAGE
   GET (240 + 44 * (P = 4), 37)-(281 + 44 * (P = 4), 44), FMV
   SCREEN , , VISPAGE, VISPAGE: PUT (MAPOUTX + X, MAPOUTY + Y + 30), FMV, PSET
 END IF

 IF P = 5 OR P = 6 THEN
   SCREEN , , VISPAGE, VISPAGE
   LINE (MAPOUTX - 2, MAPOUTY - 2)-(MAPOUTX + 81, MAPOUTY + 81), 15, BF
   LINE (MAPOUTX - 1, MAPOUTY - 1)-(MAPOUTX + 80, MAPOUTY + 80), 1, B
   DRAW "BM" + STR$(MAPOUTX) + "," + STR$(MAPOUTY) + "BRBD2"
   DRAW "C1RF2E2RD6L2U3GHD3L2U6BR8"
   DRAW "R4D2LD2RD2L4U2RU2LU2BR6"
   DRAW "R2DF2U3R2D6L2UH2D3L2U6BR8"
   DRAW "R4D2LD2RD2L4U2RU2LU2"
   DRAW "BM-13,+8R8FR3FRF2DFD3GDG2LGL3GL8HL3HLH2UHU3EUE2RER3EBFP7,1BF"
   DRAW "C1R4F2D2G5R5D2L8U2E6HL2GDL2U2E2BDP10,1"
   DRAW "BM" + STR$(MAPOUTX) + "," + STR$(MAPOUTY) + "C1BD28R80"
   RPGUPDATE 1
   PAINT (MAPOUTX, MAPOUTY), 14, 1
 END IF

END SUB

