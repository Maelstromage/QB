SUB SAVEDATA

 SCREEN , , VISPAGE, VISPAGE
 PSET (MAPOUTX - 1, MAPOUTY + 48 + 2), 1: PSET (MAPOUTX + 48, MAPOUTY - 1), 1

 FOR I = 0 TO 79 STEP 2
   DRAW "BM" + STR$(MAPOUTX + 0) + "," + STR$(MAPOUTY + -0 + I) + "C" + STR$((I + 1) MOD 16)
   FOR J = 1 TO 39: DRAW "FE": NEXT: DRAW "F"
   DRAW "BM" + STR$(MAPOUTX + 0) + "," + STR$(MAPOUTY + 79 - I) + "C" + STR$((I + 1) MOD 16)
   FOR J = 1 TO 39: DRAW "EF": NEXT: DRAW "E"
 NEXT

 OPEN "SAVEDATA.REC" FOR OUTPUT AS #1
   PRINT #1, "EVENT NUMBER       (0 TO 11)         -> ,"; EVENT
   PRINT #1, "CURRENT EXPERIENCE (0 TO 9)          -> ,"; EX
   PRINT #1, "BATTLE ROUND       (1 TO 1000)       -> ,"; ROUND
   PRINT #1, "LEVEL              (1 TO 1000)       -> ,"; LEVEL
   PRINT #1, "FLOWER         (0=HAVE / 1=DON'T)    -> ,"; FLOWER + 1
   PRINT #1, "ROM X POSITION (MAP) *do not change* -> ,"; MAPROMX
   PRINT #1, "ROM Y POSITION (MAP) *do not change* -> ,"; MAPROMY
   PRINT #1, "MAP X POSITION       *do not change* -> ,"; MAPSX
   PRINT #1, "MAP Y POSITION       *do not change* -> ,"; MAPSY
   PRINT #1, "ROM X POSITION       *do not change* -> ,"; MAPRX
   PRINT #1, "ROM Y POSITION       *do not change* -> ,"; MAPRY
   PRINT #1, "ROM'S DIRECTION      *do not change* -> ,"; MV
   PRINT #1, "MAX HP     (0 TO 500)                -> ,"; BTLMAXHP(0)
   PRINT #1, "CURRENT HP (0 TO MAX HP)             -> ,"; BTLHP(0)
   PRINT #1, "STRENGTH   (0 TO 50)                 -> ,"; BTLSTR(0)
   PRINT #1, "DEFENCE    (0 TO 50)                 -> ,"; BTLDEF(0)
   PRINT #1, "LUCK       (0 TO 50)                 -> ,"; BTLLUCK(0)
   PRINT #1, "EVADE      (0 TO 30)                 -> ,"; BTLEVADE(0)
   PRINT #1, "SPEED      (0 TO 99)                 -> ,"; BTLSPD(0)
 CLOSE #1

END SUB

