SUB MAPOFF

 SCREEN , , VISPAGE, VISPAGE

 LINE (MAPOUTX - 2, MAPOUTY - 2)-(MAPOUTX + 81, MAPOUTY + 81), 0, B

 FOR I = 0 TO 40 STEP 4
   LINE (MAPOUTX + I - 0, MAPOUTY - 1)-(MAPOUTX + 79 - I, MAPOUTY + 80), 0, B
   LINE (MAPOUTX + I - 1, MAPOUTY - 1)-(MAPOUTX + 80 - I, MAPOUTY + 80), 0, B
   LINE (MAPOUTX + I - 2, MAPOUTY - 1)-(MAPOUTX + 81 - I, MAPOUTY + 80), 0, B
   LINE (MAPOUTX + I - 3, MAPOUTY - 1)-(MAPOUTX + 82 - I, MAPOUTY + 80), 0, B
   DELAY 1
 NEXT

END SUB

'----------------------------------------------------------------------------
SUB MAPON

 SCREEN , , MAPPAGE, VISPAGE

 GET (MAPSX, MAPSY)-(MAPSX + 79, MAPSY + 79), FMV
 PUT (200, 10), FMV, PSET

 IF BATTLERESULT <> 3 THEN TPSETROM MAPROMX, MAPROMY, MV * 3 + VAL(MID$("0011111100222222", v + 1, 1))

 FOR I = 0 TO 39 STEP 4
   SCREEN , , MAPPAGE, VISPAGE
   GET (239 - I, 10)-(236 - I, 89), FMV
   SCREEN , , VISPAGE, VISPAGE
   PUT (MAPOUTX + 37 - I - 1, MAPOUTY), FMV, PSET
   SCREEN , , MAPPAGE, VISPAGE
   GET (240 + I, 10)-(243 + I, 89), FMV
   SCREEN , , VISPAGE, VISPAGE
   PUT (MAPOUTX + 40 + I, MAPOUTY), FMV, PSET
   DELAY 1
 NEXT

 LINE (MAPOUTX - 2, MAPOUTY - 2)-(MAPOUTX + 81, MAPOUTY + 81), 15, B
 LINE (MAPOUTX - 1, MAPOUTY - 1)-(MAPOUTX + 80, MAPOUTY + 80), 1, B

 IF FIRSTBATTLE THEN
   FIRSTBATTLE = FALSE
   DRAWSTATUS 38, 18, 0, 0
 ELSE
   DRAWSTATUS 38, 18, 0, 8
 END IF

 SCREEN , , MAPPAGE, VISPAGE

END SUB

