SUB LOADDATA

 SCREEN , , VISPAGE, VISPAGE
 PSET (MAPOUTX - 1, MAPOUTY + 48 + 2), 1: PSET (MAPOUTX + 48, MAPOUTY - 1), 1

 FOR I = 0 TO 79 STEP 2
   DRAW "BM" + STR$(MAPOUTX + 0) + "," + STR$(MAPOUTY + -0 + I) + "C" + STR$((I + 1) MOD 16)
   FOR J = 1 TO 39: DRAW "FE": NEXT: DRAW "F"
   DRAW "BM" + STR$(MAPOUTX + 0) + "," + STR$(MAPOUTY + 79 - I) + "C" + STR$((I + 1) MOD 16)
   FOR J = 1 TO 39: DRAW "EF": NEXT: DRAW "E"
 NEXT

 OPEN "SAVEDATA.REC" FOR INPUT AS #1
   INPUT #1, DUMMY$, EVENT
   INPUT #1, DUMMY$, EX
   INPUT #1, DUMMY$, ROUND
   INPUT #1, DUMMY$, LEVEL
   INPUT #1, DUMMY$, FLOWER
   INPUT #1, DUMMY$, MAPROMX
   INPUT #1, DUMMY$, MAPROMY
   INPUT #1, DUMMY$, MAPSX
   INPUT #1, DUMMY$, MAPSY
   INPUT #1, DUMMY$, MAPRX
   INPUT #1, DUMMY$, MAPRY
   INPUT #1, DUMMY$, MV
   INPUT #1, DUMMY$, BTLMAXHP(0)
   INPUT #1, DUMMY$, BTLHP(0)
   INPUT #1, DUMMY$, BTLSTR(0)
   INPUT #1, DUMMY$, BTLDEF(0)
   INPUT #1, DUMMY$, BTLLUCK(0)
   INPUT #1, DUMMY$, BTLEVADE(0)
   INPUT #1, DUMMY$, BTLSPD(0)
 CLOSE #1

 FLOWER = FLOWER - 1
 SCREEN , , MAPPAGE, VISPAGE
 GET (MAPSX, MAPSY)-(MAPSX + 79, MAPSY + 79), FMV: PUT (200, 10), FMV, PSET
 TPSETROM MAPROMX, MAPROMY, MV * 3 + VAL(MID$("0011111100222222", v + 1, 1))

 DELAY 3

 SCREEN , , VISPAGE, VISPAGE

 DRAWSTATUS 38, 18, 0, 0

END SUB

SUB LOADSCREEN (S$, P)
'---------------------------------------------------------------------------'
' S$ = FILENAME (6letters, 2identifier, and 'JSV'extension)                 '
' P  = PAGE (0 - 7)                                                         '
'---------------------------------------------------------------------------'

 TEMP$ = RIGHT$(S$, 6)                    'filename : 6letter + 2code

 DEF SEG = &HA000 + (&H200 * (P MOD 8))   'select page

 OUT &H3C4, &H2                           'Sequencer register
                                          '(The color plane write
                                          'enable register)
 FOR I = 0 TO 3
   OUT &H3C5, 2 ^ I                       'select plane I for writing
   BLOAD TEMP$ + "-" + LTRIM$(STR$(I)) + ".JSV", 0
 NEXT

 OUT &H3C5, &HF                           'set all plane for other functions

 DEF SEG

END SUB

SUB LOGO

 FADE COLOR2BLACK

 LOADSCREEN "LOGO", VISPAGE
 FADE BLACK2COLOR

 LOGOCOUNTER = 0
 DO
   LOGOCOUNTER = LOGOCOUNTER + 1
   DELAY 1
 LOOP UNTIL LOGOCOUNTER >= 50 OR INKEY$ <> ""

 WHILE INKEY$ <> "": WEND

END SUB

