SUB TITLEMENU

 FADE COLOR2BLACK
 SCREEN , , VISPAGE, VISPAGE: CLS
 TITLEMENUUPDATE 5
 TITLEMENUUPDATE 0
 FADE BLACK2COLOR

 DEMO2

 DONE = FALSE
 SELECTED = 0
 CURSORX = MAPOUTX + 10
 CURSORY = MAPOUTY + 29
 CURSORP = 0
 LC = 0

 WHILE INKEY$ <> "": WEND

 DO
   SELECTED = FALSE
   DO
     IF CURSORMOVE = 0 THEN
       A$ = UCASE$(INKEY$): A = RND(1)
       IF LEN(A$) = 2 THEN A$ = "*" + RIGHT$(A$, 1)
     END IF

     IF A$ = "*P" AND CURSORMOVE = 0 AND CURSORY < 79 THEN
       CURSORDIRECTION = 3: CURSORMOVE = 5: SE 3: LC = 0
     END IF

     IF A$ = "*H" AND CURSORMOVE = 0 AND CURSORY >= 50 THEN
       CURSORDIRECTION = 4: CURSORMOVE = 5: SE 2: LC = 0
     END IF

     IF A$ = " " OR A$ = CHR$(13) THEN SELECTED = TRUE: LC = 0

     IF CURSORMOVE = 0 THEN
       CURSORP = 0
       TITLEMENUUPDATE (((CURSORY - 49) \ 10) + 1)
     ELSE
       CURSORP = 1
       TITLEMENUUPDATE 0
     END IF

     IF CURSORMOVE > 0 THEN
       CURSORMOVE = CURSORMOVE - 1 - (CURSORMOVE = 0)
       SELECT CASE CURSORDIRECTION
       CASE IS = 3: CURSORY = CURSORY + 2
       CASE IS = 4: CURSORY = CURSORY - 2
       END SELECT
     END IF

     PSETCURSOR CURSORX - 8, CURSORY, 3 - CURSORP
     PSETCURSOR CURSORX + 55, CURSORY, CURSORP

     B = (B + 1) MOD 8
     A = VAL(MID$("11001122", B + 1, 1))

     RPGUPDATE A

     DELAY 1

     LC = LC + 1
     IF LC >= 70 THEN
       LC = 0
       IF DEMOCOUNT = 1 THEN
         RPGUPDATE 1
         DEMO2
         DEMOCOUNT = 0
       ELSE
         RPGUPDATE 1
         DEMO1
         DEMOCOUNT = 1
       END IF
       CURSORX = MAPOUTX + 10
       CURSORY = MAPOUTY + 29
       CURSORP = 0
     END IF

   LOOP UNTIL SELECTED

   CHOICE = ((CURSORY - 49) \ 10)

   SELECT CASE CHOICE
   CASE IS = 0
     TITLERESULT = 1
     ENDING = FALSE
     EVENT = 0
     EX = 1
     ROUND = 0
     LEVEL = 1
     FLOWER = FALSE
     FIRSTBATTLE = TRUE
     MAPROMX = 221
     MAPROMY = 68
     MAPSX = 0
     MAPSY = 64
     MAPRX = 4
     MAPRY = 16
     MV = 3
     BTLMAXHP(0) = MAXHITPOINT(0)
     BTLHP(0) = MAXHITPOINT(0)
     BTLSTR(0) = STRENGTH(0)
     BTLDEF(0) = DEFENSE(0)
     BTLLUCK(0) = LUCK(0)
     BTLEVADE(0) = EVADE(0)
     BTLSPD(0) = SPEED(0)
   CASE IS = 1: TITLERESULT = 1
     OPEN "SAVEDATA.REC" FOR INPUT AS #1
       INPUT #1, DUMMY$, EVENT
       INPUT #1, DUMMY$, EX
       INPUT #1, DUMMY$, ROUND
       INPUT #1, DUMMY$, LEVEL
       INPUT #1, DUMMY$, FLOWER
       INPUT #1, DUMMY$, MAPROMX
       INPUT #1, DUMMY$, MAPROMY
       INPUT #1, DUMMY$, MAPSX
       INPUT #1, DUMMY$, MAPSY
       INPUT #1, DUMMY$, MAPRX
       INPUT #1, DUMMY$, MAPRY
       INPUT #1, DUMMY$, MV
       INPUT #1, DUMMY$, BTLMAXHP(0)
       INPUT #1, DUMMY$, BTLHP(0)
       INPUT #1, DUMMY$, BTLSTR(0)
       INPUT #1, DUMMY$, BTLDEF(0)
       INPUT #1, DUMMY$, BTLLUCK(0)
       INPUT #1, DUMMY$, BTLEVADE(0)
       INPUT #1, DUMMY$, BTLSPD(0)
     CLOSE #1

     FLOWER = FLOWER - 1
     FIRSTBATTLE = TRUE
     CURSORX = MAPOUTX + 10
     CURSORY = MAPOUTY + 29
     CURSORP = 0
     ENDING = FALSE
   CASE IS = 2: TITLERESULT = 0: DEBUG = NOT DEBUG
     CASE IS = 3: TITLERESULT = 2
   END SELECT

   IF TITLERESULT = 1 THEN
     MAIN
     IF NOT ENDING THEN TITLEMENUUPDATE 5
   END IF
 LOOP UNTIL TITLERESULT = 2 OR ENDING

 SCREEN , , VISPAGE, VISPAGE

 FOR I = -2 TO 40
   LINE (MAPOUTX + I, MAPOUTY + I)-(MAPOUTX + 79 - I, MAPOUTY + 79 - I), 0, B
   DELAY 1
 NEXT

 DELAY 20

END SUB

