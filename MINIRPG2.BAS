'----------------------------------------------------------------------------
CONST FALSE = 0
CONST TRUE = NOT FALSE

CONST VISPAGE = 0
CONST BTLPAGE = 5
CONST MAPPAGE = 6
CONST AUXPAGE = 7

CONST COLOR2BLACK = 0
CONST BLACK2COLOR = 1

CONST MAPOUTX = 110, MAPOUTY = 20
CONST BTLOUTX = 90, BTLOUTY = 49

COMMON SHARED WALKSPEED, QUIT, GROUND, BATTLERESULT
COMMON SHARED EVENT, ENEMYNUM
COMMON SHARED MAPRX, MAPRY, MAPSX, MAPSY, MAPROMX, MAPROMY, MV
COMMON SHARED DEBUG, DEMO, SOUNDOFF
COMMON SHARED ROUND, LEVEL, FIRSTBATTLE
COMMON SHARED NEXTEXP, LEVELUP, EX, FLOWER, ENDING

DIM SHARED COLORDATA(1 TO 72)
DIM SHARED MAPAREA(0 TO 25, 0 TO 18)
DIM SHARED ROMPATTERN(0 TO 15)
DIM SHARED AMLAMR(0 TO 25, 1 TO 65)
DIM SHARED NEWFONT$(32 TO 126)
DIM SHARED BTLMENU$(8, 3)
DIM SHARED OBJX(36), OBJY(36), OBJWID(36), OBJHGT(36)
DIM SHARED FMV(1633)
DIM SHARED MAXHITPOINT(8), STRENGTH(8), DEFENSE(8), LUCK(8), EVADE(8), SPEED(8), EXPPTS(8)
DIM SHARED BTLMAXHP(1), BTLHP(1), BTLSTR(1), BTLDEF(1), BTLLUCK(1), BTLEVADE(1), BTLSPD(1)
DIM SHARED TALK1$(58), TALK2$(58), TALK3$(58), TALKC(58)

INITIALIZE
LOGO
TITLEMENU

SYSTEM

'----------------------------------------------------------------------------
SUB BATTLE

 ROUND = ROUND + 1 + (ROUND = 1000)

 IF DEMO THEN
   PUTCHV 8: TALK 1, 50, 0, 0: PUTCHV 5: DELAY 1
 ELSE
   IF EVENT <= 4 THEN
     TALK 3, 16 + (EVENT * 2) + 1, 0, 0: DELAY 2
     TALK 2, 17 + (EVENT * 2) + 1, 0, 0: DELAY 2
     EVENT = EVENT + 1
   END IF
   PUTCHV 8: TALK 1, 0, 0, ROUND: PUTCHV 5: DELAY 1
 END IF

 SCREEN , , VISPAGE, VISPAGE
 CURSORX = 144: CURSORY = 110: BATTLERESULT = 0
 DO
   CURSORP = 0
   PSETCURSOR CURSORX, CURSORY, CURSORP
   SELECTED = 0
   COUNTDOWN = 10 + INT(RND(1) * 10) - ((1 \ -1) \ 2)

   WHILE INKEY$ <> "": WEND

   DO
     IF CURSORMOVE = 0 THEN
       IF NOT DEMO THEN
         A$ = UCASE$(INKEY$): A = RND(1)
         IF LEN(A$) = 2 THEN A$ = "*" + RIGHT$(A$, 1)
       ELSE
         A$ = MID$("*P*H", INT(RND(1) * 2) * 2 + 1, 2)
           IF CURSORY <= 110 THEN A$ = "*P"
           IF CURSORY >= 128 THEN A$ = "*H"
           COUNTDOWN = COUNTDOWN - 1 - (COUNTDOWN = 0)
           IF COUNTDOWN = 0 THEN A$ = " "
       END IF
     END IF

     IF A$ = "*P" AND CURSORMOVE = 0 AND CURSORY < 128 THEN CURSORDIRECTION = 3: CURSORMOVE = 5: SE 3
     IF A$ = "*H" AND CURSORMOVE = 0 AND CURSORY > 110 THEN CURSORDIRECTION = 4: CURSORMOVE = 5: SE 2
     IF A$ = " " OR A$ = CHR$(13) THEN SELECTED = TRUE

     IF CURSORMOVE = 0 THEN
       CURSORP = 0
       DRAW "BM91," + STR$(CURSORY + 7) + "C8R50D10L50U10"
     ELSE
       CURSORP = 1:
       DRAW "BM91,117C14R50D10NL50D10NL50D10L50U10U10U10"
     END IF

     IF CURSORMOVE > 0 THEN
       SELECT CASE CURSORDIRECTION
       CASE IS = 3
         CURSORY = CURSORY + 2
         CURSORMOVE = CURSORMOVE - 1 - (CURSORMOVE = 0)
       CASE IS = 4
         CURSORY = CURSORY - 2
         CURSORMOVE = CURSORMOVE - 1 - (CURSORMOVE = 0)
       END SELECT
     END IF

     PSETCURSOR CURSORX, CURSORY, CURSORP
     DELAY 1
   LOOP UNTIL SELECTED

   FOR I = 1 TO 4
     DRAW "BM91," + STR$(CURSORY + 7) + "C 8R50D10L50U10": DELAY 1
     DRAW "BM91," + STR$(CURSORY + 7) + "C14R50D10L50U10": DELAY 1
   NEXT

   CHOICE = (CURSORY - 110) \ 9

   SELECT CASE CHOICE
   CASE IS = 0 '- rom attack (menu 0) -
     ROMATKPTN = ABS(RND(1) < (BTLLUCK(0) / 100)) + 1
     LC = 0: OB = FALSE: OBX = 0: OBY = 0: OBP = 1
     ENEMYV = 0: ENEMYP = 0: ATTACKRESULT = 0
     DAMAGE = BTLSTR(0) - BTLDEF(1) - INT(BTLSTR(0) * .5) * (ROMATKPTN = 2)
     IF DAMAGE <= 0 THEN DAMAGE = 1
     IF DEMO THEN DAMAGE = 0
     IF (ENEMYNUM > 5) AND (RND(1) < (EVADE(ENEMYNUM) / 100)) THEN
       ATTACKRESULT = 3

       IF ROMATKPTN = 1 THEN
         ENEMYP = VAL(MID$("0000000000455663", (ENEMYNUM - 1) * 2 + 1, 2))
       ELSE
         ENEMYP = VAL(MID$("0000000000455763", (ENEMYNUM - 1) * 2 + 1, 2))
       END IF

     ELSEIF DAMAGE >= BTLHP(1) THEN
       DAMAGE = BTLHP(1): ATTACKRESULT = 2: BATTLERESULT = 2
       ENEMYP = VAL(MID$("1822323640475965", (ENEMYNUM - 1) * 2 + 1, 2))
     ELSE
       ATTACKRESULT = 1
       ENEMYP = VAL(MID$("1721313539465864", (ENEMYNUM - 1) * 2 + 1, 2))
     END IF

     ENEMYV = 1: RFMV = FALSE: STAR = FALSE: DIA = FALSE
     STARX = 0: STARY = 0: STARP = 29

     DO
       SCREEN , , BTLPAGE, VISPAGE
       LINE (50, -0 - 0)-(170, 50 - 0), 14, BF
       LINE (50, 50 - 3)-(170, 50 - 3), 3
       LINE (50, 50 - 2)-(170, 50 - 1), 2, B
       LINE (50, 50 - 0)-(170, 50 - 0), 12

       IF DEMO THEN
         SCREEN , , AUXPAGE, VISPAGE: GET (51, 52)-(51 + 54, 52 + 17), FMV
         SCREEN , , BTLPAGE, VISPAGE: PUT (75 + 8, 29 - 0), FMV, PSET
       END IF

       LC = LC + 1
       LPTN = LC: IF LC > AMLAMR(0, ROMATKPTN) THEN LPTN = 1
       IF LC = 8 AND ROMATKPTN = 1 THEN OB = TRUE: OBX = 74: OBY = 31: OBP = 1
       IF LC = 5 AND ROMATKPTN = 2 THEN OB = TRUE: OBX = 68: OBY = 35: OBP = 2
       IF OB THEN OBX = OBX + 4: IF OBX >= 200 THEN OB = FALSE

       IF ATTACKRESULT = 3 THEN
         IF ROMATKPTN = 1 THEN
           IF LC = VAL(MID$("0000000000252527", (ENEMYNUM - 1) * 2 + 1, 2)) THEN
             STARX = VAL(MID$("000000000000000139138148", (ENEMYNUM - 1) * 3 + 1, 3))
             STARY = VAL(MID$("0000000000312731", (ENEMYNUM - 1) * 2 + 1, 2))
             DIA = TRUE: STARP = 32: STARV = 0: OB = FALSE: OBX = 0
           END IF
         ELSE
           IF LC = VAL(MID$("0000000000212224", (ENEMYNUM - 1) * 2 + 1, 2)) THEN
             STARX = VAL(MID$("000000000000000137141150", (ENEMYNUM - 1) * 3 + 1, 3))
             STARY = VAL(MID$("0000000000363636", (ENEMYNUM - 1) * 2 + 1, 2))
             DIA = TRUE: STARP = 32: STARV = 0: OB = FALSE: OBX = 0
           END IF
         END IF
       ELSE
         IF ROMATKPTN = 1 THEN
           IF LC = VAL(MID$("2625252527262628", (ENEMYNUM - 1) * 2 + 1, 2)) THEN
             STAR = TRUE
             STARX = VAL(MID$("145145145145147145145153", (ENEMYNUM - 1) * 3 + 1, 3))
             STAR = TRUE: STARY = 30: STARP = 29: STARV = 0: OB = FALSE: OBX = 0
           END IF
         ELSE
           IF LC = VAL(MID$("2222242422222224", (ENEMYNUM - 1) * 2 + 1, 2)) THEN
             STARX = VAL(MID$("145145147147147146146153", (ENEMYNUM - 1) * 3 + 1, 3))
             STAR = TRUE: STARY = 36: STARP = 29: STARV = 0: OB = FALSE: OBX = 0
           END IF
         END IF
       END IF

       IF DIA THEN
         STARP = VAL(MID$("3334353433", STARV * 2 + 1, 2))
         STARV = STARV + 1: IF STARV >= 6 THEN DIA = FALSE: STARX = 0
       END IF

       IF STAR THEN
         STARP = STARP + 1
         STARV = STARV + 1: IF STARV >= 4 THEN STAR = FALSE: STARX = 0
       END IF

       SELECT CASE ATTACKRESULT
       CASE IS = 1
         IF LC = VAL(MID$("2726262629252628 2323242424212324", (ENEMYNUM - 1) * 2 + 1 + (ROMATKPTN - 1) * 17, 2)) THEN RFMV = TRUE
       CASE IS = 2
         IF LC = VAL(MID$("2726262629252828 2323242424212525", (ENEMYNUM - 1) * 2 + 1 + (ROMATKPTN - 1) * 17, 2)) THEN RFMV = TRUE
       CASE IS = 3
         IF LC = VAL(MID$("0000000000191720 0000000000161417", (ENEMYNUM - 1) * 2 + 1 + (ROMATKPTN - 1) * 17, 2)) THEN RFMV = TRUE
       END SELECT

       IF RFMV THEN ENEMYV = ENEMYV + 1 + (ENEMYV = AMLAMR(0, ENEMYP))
       IF NOT OB THEN OBX = 0

       PUTFMV 50, 19, LPTN, ROMATKPTN, BTLPAGE
       PUTFMV 139, 19, ENEMYV, ENEMYP, BTLPAGE
       TPSETOBJECT OBX, OBY, OBP
       TPSETOBJECT STARX, STARY, STARP
       SCREEN , , BTLPAGE, VISPAGE: GET (50, 0)-(50 + 120, 50), FMV
       SCREEN , , VISPAGE, VISPAGE: PUT (BTLOUTX, BTLOUTY), FMV, PSET

       DELAY 1

     LOOP UNTIL AMLAMR(0, ENEMYP) = ENEMYV
     IF ATTACKRESULT <> 3 THEN DAMAGEUPDATE 1, DAMAGE

   CASE IS = 1 '- rom drink (menu 2) -
     FOR I = 1 TO AMLAMR(0, 3)
       PUTFMV 50, 19, I, 3, BTLPAGE
       SCREEN , , BTLPAGE, VISPAGE: GET (50, 0)-(50 + 120, 50), FMV
       SCREEN , , VISPAGE, VISPAGE: PUT (BTLOUTX, BTLOUTY), FMV, PSET
       DELAY 1
     NEXT

     HPRANGE = 3
     HP = 10 + INT(BTLMAXHP(0) / 10) + INT(RND(1) * HPRANGE) - ((HPRANGE - 1) \ 2)
     SCREEN , , VISPAGE, VISPAGE

     DO
       BTLHP(0) = BTLHP(0) + 1 + (BTLHP(0) = BTLMAXHP(0))
       DRAWNEWFONT 53, 21, 1, 15, 2, RIGHT$("   " + LTRIM$(STR$(BTLHP(0))), 3)
       UPDATEHPBAR 0, BTLHP(0): HP = HP - 1 - (HP = 0)
     LOOP UNTIL (BTLHP(0) = BTLMAXHP(0)) OR (HP = 0)

   CASE IS = 2
     IF RND(1) < (BTLSPD(0) / 100) AND ENEMYNUM <= 4 AND NOT DEMO THEN
       FOR I = 1 TO AMLAMR(0, 4)
         PUTFMV 50, 19, I, 4, BTLPAGE
         SCREEN , , BTLPAGE, VISPAGE: GET (50, 0)-(50 + 120, 50), FMV
         SCREEN , , VISPAGE, VISPAGE: PUT (BTLOUTX, BTLOUTY), FMV, PSET
         DELAY 1
       NEXT
       BATTLERESULT = 1
     ELSE
       PUTCHV 8
       IF ENEMYNUM >= 5 THEN TALK 1, 14, 0, 0 ELSE TALK 1, 13, 0, 0
       PUTCHV 5: DELAY 1
     END IF
   END SELECT

   IF BATTLERESULT = 0 THEN
     FOR I = 0 TO 2: PSETCURSOR CURSORX, CURSORY, I: DELAY 2: NEXT

     DO
       CURSORY = CURSORY + 2 * (CURSORY > 110)
       PSETCURSOR CURSORX, CURSORY, 2
       DELAY 1
     LOOP UNTIL CURSORY <= 110

     CURSORP = 3
     PSETCURSOR CURSORX, CURSORY, CURSORP
     SELECTED = 0
     COUNTDOWN = 10 + INT(RND(1) * 10) - ((1 \ -1) \ 2)

     WHILE INKEY$ <> "": WEND

     DO
       IF CURSORMOVE = 0 THEN
         IF DEBUG AND NOT DEMO THEN
           A$ = UCASE$(INKEY$): A = RND(1): IF LEN(A$) = 2 THEN A$ = "*" + RIGHT$(A$, 1)
         ELSE
           A$ = MID$("*P*H", INT(RND(1) * 2) * 2 + 1, 2)
           IF CURSORY <= 110 THEN A$ = "*P"
           IF CURSORY >= 128 THEN A$ = "*H"
           COUNTDOWN = COUNTDOWN - 1 - (COUNTDOWN = 0)
           IF COUNTDOWN <= 0 THEN A$ = " "
         END IF
       END IF

       IF A$ = "*P" AND CURSORMOVE = 0 AND CURSORY < 128 THEN CURSORDIRECTION = 3: CURSORMOVE = 5: SE 3
       IF A$ = "*H" AND CURSORMOVE = 0 AND CURSORY > 110 THEN CURSORDIRECTION = 4: CURSORMOVE = 5: SE 2
       IF A$ = " " OR A$ = CHR$(13) THEN SELECTED = -1

       IF CURSORMOVE = 0 THEN
         CURSORP = 3: DRAW "BM159," + STR$(CURSORY + 7) + "C8R50D10L50U10"
       ELSE
         CURSORP = 2: DRAW "BM159,117C14R50D10NL50D10NL50D10L50U10U10U10"
       END IF

       IF CURSORMOVE > 0 THEN
          SELECT CASE CURSORDIRECTION
          CASE IS = 3
            CURSORY = CURSORY + 2
          CURSORMOVE = CURSORMOVE - 1 - (CURSORMOVE = 0)
            CASE IS = 4
          CURSORY = CURSORY - 2
            CURSORMOVE = CURSORMOVE - 1 - (CURSORMOVE = 0)
          END SELECT
       END IF

       PSETCURSOR CURSORX, CURSORY, CURSORP
       DELAY 1

     LOOP UNTIL SELECTED

     FOR I = 1 TO 4
       DRAW "BM159," + STR$(CURSORY + 7) + "C 8R50D10L50U10": DELAY 1
       DRAW "BM159," + STR$(CURSORY + 7) + "C14R50D10L50U10": DELAY 1
     NEXT

     CHOICE = (CURSORY - 110) \ 9
     SELECT CASE CHOICE
     CASE IS = 2
       TALK 3, ENEMYNUM, 0, 0
       IF ENEMYNUM = 1 THEN TALK 2, 26, 0, 0
     CASE ELSE
       LC = 0: OB = FALSE: OBX = 0: OBY = 0: OBP = 1
       DAMAGE = 0: ATTACKRESULT = 0
       GUESTX = 0: GUESTY = 0: GUESTP = 41: GUESTV = 1
       ENEMYACTLIST = ((ENEMYNUM - 1) * 2 + CHOICE)
       ENEMYP = VAL(MID$("15162023293033343838434455556162", ENEMYACTLIST * 2 + 1, 2))
       DAMAGE = BTLSTR(1) - BTLDEF(0) - INT(BTLSTR(1) * .5) * (CHOICE = 1)
       IF DAMAGE <= 0 THEN DAMAGE = 1
       IF ENEMYACTLIST = 3 OR DEBUG OR DEMO THEN DAMAGE = 0

       IF RND(1) < (BTLEVADE(0) / 100) THEN
         ATTACKRESULT = 3: LFMVP = 5
       ELSEIF DAMAGE >= BTLHP(0) THEN
         DAMAGE = BTLHP(0)
         ATTACKRESULT = 2: BATTLERESULT = 3: LFMVP = 12
       ELSE
         ATTACKRESULT = 1
         LFMVP = VAL(MID$("10110613060606060707060606060606", ENEMYACTLIST * 2 + 1, 2))
       END IF

       LFMV = FALSE: LFMVV = 1: LFMVPV = 0: STAR = FALSE: DIA = FALSE
       STARX = 0: STARY = 0: STARP = 29: DONE = FALSE

       DO
         SCREEN , , BTLPAGE, VISPAGE
         LINE (50, -0 - 0)-(170, 50 - 0), 14, BF
         LINE (50, 50 - 3)-(170, 50 - 3), 3
         LINE (50, 50 - 2)-(170, 50 - 1), 2, B
         LINE (50, 50 - 0)-(170, 50 - 0), 12

         IF DEMO THEN
            SCREEN , , AUXPAGE, VISPAGE: GET (51, 52)-(51 + 54, 52 + 17), FMV
            SCREEN , , BTLPAGE, VISPAGE: PUT (75 + 8, 29 - 0), FMV, PSET
         END IF

         LC = LC + 1
         ENEMYV = LC: IF LC > AMLAMR(0, ENEMYP) THEN ENEMYV = 1

         IF (ENEMYACTLIST = 4 OR ENEMYACTLIST = 5) AND LC = 14 THEN
           GUEST = TRUE: GUESTX = 115: GUESTY = 19: GUESTP = 37 + ENEMYACTLIST: GUESTV = 0
         END IF

         IF GUEST THEN GUESTV = GUESTV + 1: IF GUESTV >= AMLAMR(0, GUESTP) THEN GUEST = FALSE

         IF LC = (VAL(MID$("08080600302610080306080511111009", ENEMYACTLIST * 2 + 1, 2))) THEN
           OBX = VAL(MID$("55554800152047477979393542424950", ENEMYACTLIST * 2 + 1, 2)) + 100
           OBY = VAL(MID$("33373500323431352734313534383130", ENEMYACTLIST * 2 + 1, 2))
           OBP = VAL(MID$("03040400142009101111212222222827", ENEMYACTLIST * 2 + 1, 2))
           OBZ = VAL(MID$("02030400050601010202010104040101", ENEMYACTLIST * 2 + 1, 2))
           OB = TRUE
           OBJPV = 0
         END IF

         IF OB THEN
           SELECT CASE OBZ
           CASE IS = 1
             OBX = OBX - 4: IF OBX <= 10 THEN OB = FALSE
           CASE IS = 2
             OBJPV = OBJPV + 1: IF OBJPV >= 7 THEN OBJPV = 1
             OBY = OBY + (VAL(MID$("+0+1+1+0-1-1", (OBJPV - 1) * 2 + 1, 2)))
             OBX = OBX - 4: IF OBX <= 10 THEN OB = FALSE
           CASE IS = 3
             OBJPV = OBJPV + 1: IF OBJPV >= 8 THEN OBJPV = 1
             OBX = OBX + (VAL(MID$("-4-5+2+2+2-5-4", (OBJPV - 1) * 2 + 1, 2)))
             OBY = OBY + (VAL(MID$("-2-4-6+0+6+4+2", (OBJPV - 1) * 2 + 1, 2)))
             IF OBX <= 10 THEN OB = FALSE
           CASE IS = 4
             OBX = OBX - 4: IF OBX <= 10 THEN OB = FALSE
             OBP = OBP + 1: OBJPV = OBJPV + 1
             IF OBJPV >= 5 THEN OBJPV = 1: OBP = OBP - 4
           CASE IS = 5
             OBX = OBX - 4: IF OBX <= 10 THEN OB = FALSE
             OBP = OBP + 1: IF OBP >= 20 THEN OBP = 12
           CASE IS = 6
             OBX = OBX - 4: IF OBX <= 10 THEN OB = FALSE
             OBJPV = OBJPV + 1: IF OBJPV >= 7 THEN OBJPV = 1
             OBY = OBY + (VAL(MID$("+0-1-1+0+1+1", (OBJPV - 1) * 2 + 1, 2)))
           END SELECT
         END IF

         IF ATTACKRESULT = 3 THEN
           IF LC = (((VAL(MID$("29572600433929283133252231293029", ENEMYACTLIST * 2 + 1, 2))))) THEN
             STARX = VAL(MID$("66666600656666686468666865676865", ENEMYACTLIST * 2 + 1, 2))
             STARY = VAL(MID$("30333300303232362835323631353631", ENEMYACTLIST * 2 + 1, 2))
             DIA = TRUE: STARP = 29: STARV = 0: OB = FALSE
           END IF
         ELSE
           IF LC = (((VAL(MID$("31592800444231303235272432323231", ENEMYACTLIST * 2 + 1, 2))))) THEN
             STARX = VAL(MID$("60585900585858585959585860575860", ENEMYACTLIST * 2 + 1, 2))
             STARY = VAL(MID$("28263200302831362633313630353631", ENEMYACTLIST * 2 + 1, 2))
             STAR = TRUE: STARP = 29: STARV = 0: OB = FALSE
           END IF
         END IF

         IF DIA THEN
           STARP = VAL(MID$("3334353433", STARV * 2 + 1, 2))
           STARV = STARV + 1: IF STARV >= 6 THEN DIA = FALSE: STARX = 0
         END IF

         IF STAR THEN
           STARP = STARP + 1
           STARV = STARV + 1: IF STARV >= 4 THEN STAR = FALSE: STARX = 0
         END IF

         IF ATTACKRESULT = 3 THEN
           IF LC = VAL(MID$("24532100373423222528201725252424", ENEMYACTLIST * 2 + 1, 2)) THEN LFMV = TRUE
         ELSE
           IF LC = VAL(MID$("33612900454332313336282533333332", ENEMYACTLIST * 2 + 1, 2)) THEN LFMV = TRUE
         END IF

         IF LFMV THEN
           LFMVV = LFMVV + 1
           IF LFMVV >= AMLAMR(0, LFMVP) THEN
             LFMVV = AMLAMR(0, LFMVP): DONE = TRUE
           END IF
         END IF

         IF NOT GUEST THEN GUESTX = 0: GUESTY = 0: GUESTP = 41: GUESTV = 1
         IF NOT OB THEN OBX = 0: OBY = 0: OBP = 3
         PUTFMV 139, 19, ENEMYV, ENEMYP, BTLPAGE
         PUTFMV 50, 19, LFMVV, LFMVP, BTLPAGE
         PUTFMV GUESTX, GUESTY, GUESTV, GUESTP, BTLPAGE
         TPSETOBJECT OBX, OBY, OBP
         TPSETOBJECT STARX, STARY, STARP

         IF (LFMVV >= AMLAMR(0, LFMVP)) AND ATTACKRESULT = 1 THEN
           IF ENEMYNUM = 5 THEN
             LFMVV = 0: LFMVPV = LFMVPV + 1
             LFMVP = VAL(MID$("08080809", (LFMVPV - 1) * 2 + 1, 2))
             IF LFMVPV = 5 THEN DONE = TRUE ELSE DONE = FALSE
           END IF
         END IF

         IF ENEMYACTLIST = 3 THEN
           IF ENEMYV = AMLAMR(0, ENEMYP) THEN DONE = TRUE
         END IF

         SCREEN , , BTLPAGE, VISPAGE: GET (50, 0)-(50 + 120, 50), FMV
         SCREEN , , VISPAGE, VISPAGE: PUT (BTLOUTX, BTLOUTY), FMV, PSET

         DELAY 1

         IF ENEMYACTLIST = 3 AND LC = 16 THEN TALK 3, 12, 0, 0

         IF LC >= 100 THEN DONE = TRUE

       LOOP UNTIL DONE

       IF ATTACKRESULT <> 3 THEN DAMAGEUPDATE 0, DAMAGE
     END SELECT

     IF BATTLERESULT <> 3 AND NOT DEMO THEN
       SCREEN , , VISPAGE, VISPAGE
       FOR I = 3 TO 1 STEP -1
         PSETCURSOR CURSORX, CURSORY, I: DELAY 2
       NEXT

       DO
         CURSORY = CURSORY + 2 * (CURSORY > 110)
         PSETCURSOR CURSORX, CURSORY, 1: DELAY 1
       LOOP UNTIL CURSORY <= 110

       PSETCURSOR CURSORX, CURSORY, 0
     END IF
   END IF

 LOOP UNTIL BATTLERESULT <> 0 OR DEMO

 IF NOT DEMO THEN
   SELECT CASE BATTLERESULT
   CASE IS = 1
     PUTCHV 2: DELAY 2: TALK 1, 9, 0, 0
   CASE IS = 2
     PUTCHV 3: DELAY 2: TALK 1, 10, 0, 0
     IF ENEMYNUM <= 4 THEN
       TALK 1, 0, 8, EXPPTS(ENEMYNUM)
       LEVELUP = FALSE
       FOR I = 1 TO EXPPTS(ENEMYNUM)
         EX = (EX + 1) MOD 10
         IF EX = 0 THEN LEVELUP = TRUE
       NEXT
       IF LEVELUP THEN
         LVUP
       ELSE
         TALK 1, 0, 9, 10 - EX
       END IF
     END IF
   CASE IS = 3
     PUTCHV 7: DELAY 2: TALK 1, 11, 0, 0
   END SELECT
 ELSE
   PUTCHV 7: DELAY 2: TALK 1, 51, 0, 0
 END IF

 PUTCHV 5

 DELAY 2

END SUB

'----------------------------------------------------------------------------
SUB BEEEP

' SOUND 4000, .5

END SUB

'----------------------------------------------------------------------------
SUB BTLOFF

 SCREEN , , VISPAGE, VISPAGE
 LINE (215, 18)-(282, 101), 0, BF
