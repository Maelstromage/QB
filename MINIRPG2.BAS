SUB CINEMA

 FLOWER = FALSE: ENEMYNUM = 7
 MAPOFF
 BTLON

 TALK 3, 35, 0, 0: DELAY 2
 TALK 3, 37, 0, 0: DELAY 2
 TALK 2, 38, 0, 0: DELAY 2
 TALK 3, 39, 0, 0: DELAY 2
 TALK 2, 40, 0, 0: DELAY 2

 LC = 0: BEE = FALSE: BEEX = 0: BEEY = 0: BEEPTN = 1

 DO
   SCREEN , , BTLPAGE, VISPAGE
   LINE (50, 0)-(170, 50), 14, BF
   LINE (50, 47)-(170, 47), 3
   LINE (50, 48)-(170, 49), 2, B
   LINE (50, 50)-(170, 50), 12

   LC = LC + 1
   IF LC = 1 THEN BEE = TRUE: BEEX = 179: BEEY = 20

   IF BEE THEN
     BEEV = BEEV + 1 + (BEEV = 74)
     BEEPTN = VAL(MID$("0000000000000000000011111111111111111111111111111111111111111111111111111111", BEEV, 1))
     BEEX = BEEX + VAL(MID$("0000000000000000000011111111111122222233322211122233322211122233333333334444", BEEV, 1)) - 2
     BEEY = BEEY + VAL(MID$("4567876543210123", BEEV MOD 16 + 1, 1)) - 4
     IF BEEV >= 74 THEN BEE = FALSE
   END IF

   PUTFMV 50, 19, 1, 1, BTLPAGE
   PUTFMV 139, 19, 1, 60, BTLPAGE
   TPSETOBJECT BEEX, BEEY, 11 + BEEPTN * 25
   SCREEN , , BTLPAGE, VISPAGE: GET (50, 0)-(170, 50), FMV
   SCREEN , , VISPAGE, VISPAGE: PUT (BTLOUTX, BTLOUTY), FMV, PSET

   DELAY 1

 LOOP UNTIL LC >= 74

 TALK 3, 41, 0, 0: DELAY 2
 TALK 2, 42, 0, 0: DELAY 2

 LC = 0: OB = FALSE
 OBX = 0: OBY = 0: OBP = 1
 STARX = 0: STARY = 0: STARP = 1
 ROMATKPTN = 1: ENEMYV = 1: ENEMYP = 50
 BEE = FALSE: BEEX = 141: BEEY = 33: BEEPTN = 36
 LFMV = FALSE

 DO
   SCREEN , , BTLPAGE, VISPAGE
   LINE (50, 0)-(170, 50), 14, BF
   LINE (50, 47)-(170, 47), 3
   LINE (50, 48)-(170, 49), 2, B
   LINE (50, 50)-(170, 50), 12

   LC = LC + 1: IF LC = 1 THEN LFMV = TRUE
   IF LFMV THEN LFMVV = LFMVV + 1 + (LFMVV = AMLAMR(0, ROMATKPTN))
   IF LC = 8 THEN OB = TRUE: OBX = 74: OBY = 31: OBP = 1
   IF OB THEN OBX = OBX + 4: IF OBX >= 200 THEN OB = FALSE

   IF LC = 26 THEN
     STAR = TRUE: STARX = 145: STARY = 30
     STARP = 29: STARV = 0: OB = FALSE: OBX = 0
   END IF

   IF STAR THEN
     STARP = STARP + 1
     STARV = STARV + 1: IF STARV >= 4 THEN STAR = FALSE: STARX = 0
   END IF

   IF LC = 26 THEN RFMV = TRUE
   IF RFMV THEN ENEMYV = ENEMYV + 1 + (ENEMYV = AMLAMR(0, ENEMYP))
   IF LC = 12 THEN BEE = TRUE: BEEX = 141: BEEY = 33: BEEV = 0

   IF BEE THEN
     BEEV = BEEV + 1 + (BEEV = 52)
     BEEX = BEEX + VAL(MID$("222222222222222000000000000000000000000000000000", BEEV, 1))
     BEEY = BEEY + VAL(MID$("8765432101234567", BEEV MOD 16 + 1, 1)) - 4
   END IF

   IF NOT OB THEN OBX = 0
   IF NOT STAR THEN STARX = 0

   PUTFMV 50, 19, LFMVV, ROMATKPTN, BTLPAGE
   PUTFMV 139, 19, ENEMYV, ENEMYP, BTLPAGE
   TPSETOBJECT OBX, OBY, OBP
   TPSETOBJECT STARX, STARY, STARP
   TPSETOBJECT BEEX, BEEY, BEEPTN

   SCREEN , , BTLPAGE, VISPAGE: GET (50, 0)-(170, 50), FMV
   SCREEN , , VISPAGE, VISPAGE: PUT (BTLOUTX, BTLOUTY), FMV, PSET: DELAY 1

   IF AMLAMR(0, ENEMYP) = ENEMYV THEN ENEMYP = ENEMYP + 1: ENEMYV = 0
 LOOP UNTIL (ENEMYP >= 55)

 TALK 3, 43, 0, 0: DELAY 2
 TALK 2, 44, 0, 0: DELAY 2
 TALK 2, 45, 0, 0: DELAY 2

 BATTLE

 IF BATTLERESULT <> 3 THEN
   BTLOFF
   ENEMYNUM = 8
   BTLON
   TALK 3, 46, 0, 0: DELAY 2
   TALK 2, 47, 0, 0: DELAY 2
   TALK 3, 48, 0, 0: DELAY 2
   TALK 3, 49, 0, 0: DELAY 2
   BATTLE
 END IF

 BTLOFF
 MAPON

END SUB

