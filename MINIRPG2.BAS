SUB LVUP

 LEVEL = LEVEL + 1 + (LEVEL = 99)
 TALK 1, 0, 1, LEVEL

 IF BTLMAXHP(0) < 500 THEN
   RANGE = 5 + INT(RND(1) * 25) + 1
   IF RANGE >= 500 - BTLMAXHP(0) THEN RANGE = 500 - BTLMAXHP(0)
   IF RANGE <> 0 THEN
     TALK 1, 0, 2, RANGE
     FOR I = 1 TO RANGE
       BTLMAXHP(0) = BTLMAXHP(0) + 1
       DRAWSTATUS 18, 18, 0, 2
     NEXT
   END IF
 END IF

 IF BTLSTR(0) < 50 THEN
   RANGE = INT(RND(1) * 3) + 1
   IF RANGE >= 50 - BTLSTR(0) THEN RANGE = 50 - BTLSTR(0)
   IF RANGE <> 0 THEN
     TALK 1, 0, 3, RANGE
     FOR I = 1 TO RANGE
       BTLSTR(0) = BTLSTR(0) + 1
       DRAWSTATUS 18, 18, 0, 3
     NEXT
   END IF
 END IF

 IF BTLDEF(0) < 50 THEN
   RANGE = INT(RND(1) * 3) + 1
   IF RANGE >= 50 - BTLDEF(0) THEN RANGE = 50 - BTLDEF(0)
   IF RANGE <> 0 THEN
     TALK 1, 0, 4, RANGE
     FOR I = 1 TO RANGE
       BTLDEF(0) = BTLDEF(0) + 1
       DRAWSTATUS 18, 18, 0, 4
     NEXT
   END IF
 END IF

 IF BTLLUCK(0) < 50 THEN
   RANGE = INT(RND(1) * 3) + 1
   IF RANGE >= 50 - BTLLUCK(0) THEN RANGE = 50 - BTLLUCK(0)
   IF RANGE <> 0 THEN
     TALK 1, 0, 5, RANGE
     FOR I = 1 TO RANGE
       BTLLUCK(0) = BTLLUCK(0) + 1
       DRAWSTATUS 18, 18, 0, 5
     NEXT
   END IF
 END IF

 IF BTLEVADE(0) < 30 THEN
   RANGE = INT(RND(1) * 3) + 1
   IF RANGE >= 30 - BTLEVADE(0) THEN RANGE = 30 - BTLEVADE(0)
   IF RANGE <> 0 THEN
     TALK 1, 0, 6, RANGE
     FOR I = 1 TO RANGE
       BTLEVADE(0) = BTLEVADE(0) + 1
       DRAWSTATUS 18, 18, 0, 6
     NEXT
   END IF
 END IF

 IF BTLSPD(0) < 99 THEN
   RANGE = INT(RND(1) * 3) + 1
   IF RANGE >= 99 - BTLSPD(0) THEN RANGE = 99 - BTLSPD(0)
   IF RANGE <> 0 THEN
     TALK 1, 0, 7, RANGE
     FOR I = 1 TO RANGE
       BTLSPD(0) = BTLSPD(0) + 1
       DRAWSTATUS 18, 18, 0, 7
     NEXT
   END IF
 END IF

END SUB

'----------------------------------------------------------------------------
SUB MAIN

 SCREEN , , VISPAGE, VISPAGE: CLS
 SCREEN , , MAPPAGE, VISPAGE

 MAPON
 QUIT = FALSE
 SCREEN , , MAPPAGE, VISPAGE

 WHILE INKEY$ <> "": WEND

 DO
   A$ = UCASE$(INKEY$): A = RND(1)
   IF LEN(A$) = 2 THEN A$ = "*" + RIGHT$(A$, 1)
   IF A$ = "*K" AND WALK = 0 THEN MV = 0: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRX = MAPRX - 1 - (MAPRX = 1): SE 4
   IF A$ = "*M" AND WALK = 0 THEN MV = 3: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRX = MAPRX + 1 + (MAPRX = 24): SE 4
   IF A$ = "*P" AND WALK = 0 THEN MV = 1: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRY = MAPRY + 1 + (MAPRY = 16): SE 4
   IF A$ = "*H" AND WALK = 0 THEN MV = 2: WALK = 4 - ((WALKSPEED = 1) * 4): MAPRY = MAPRY - 1 - (MAPRY = 1): SE 4

   IF WALK <> 0 THEN
     WALK = WALK - 1
     IF WALK = 0 THEN GROUND = MAPAREA(MAPRX, MAPRY): CHECK = TRUE
     v = v + WALKSPEED
     IF v >= 16 THEN v = 0

     SELECT CASE MV
     CASE IS = 0
       IF MAPROMX > 229 OR MAPSX <= 0 THEN
         MAPROMX = MAPROMX - WALKSPEED
         IF MAPROMX <= 197 THEN MAPROMX = 197
       ELSE
         MAPSX = MAPSX - WALKSPEED
         IF MAPSX <= 0 THEN MAPSX = 0
       END IF
     CASE IS = 1
       IF MAPROMY <= 43 OR MAPSY >= 64 THEN
         MAPROMY = MAPROMY + WALKSPEED
         IF MAPROMY >= 68 THEN MAPROMY = 68
       ELSE
         MAPSY = MAPSY + WALKSPEED
         IF MAPSY >= 64 THEN MAPSY = 64
       END IF
     CASE IS = 2
       IF MAPROMY > 44 OR MAPSY <= 0 THEN
         MAPROMY = MAPROMY - WALKSPEED
         IF MAPROMY <= 12 THEN MAPROMY = 12
       ELSE
         MAPSY = MAPSY - WALKSPEED
         IF MAPSY <= 0 THEN MAPSY = 0
       END IF
     CASE IS = 3
       IF MAPROMX <= 228 OR MAPSX >= 112 THEN
         MAPROMX = MAPROMX + WALKSPEED
         IF MAPROMX >= 269 THEN MAPROMX = 269
       ELSE
         MAPSX = MAPSX + WALKSPEED
         IF MAPSX >= 112 THEN MAPSX = 112
       END IF
     END SELECT
   END IF

   SCREEN , , MAPPAGE, VISPAGE
   GET (MAPSX, MAPSY)-(MAPSX + 79, MAPSY + 79), FMV
   PUT (200, 10), FMV, PSET
   IF BATTLERESULT <> 3 THEN TPSETROM MAPROMX, MAPROMY, MV * 3 + VAL(MID$("0011111100222222", v + 1, 1))
   GET (200, 10)-(279, 89), FMV
   SCREEN , , VISPAGE, VISPAGE
   PUT (MAPOUTX, MAPOUTY), FMV, PSET
   SCREEN , , MAPPAGE, VISPAGE

   IF A$ = CHR$(27) AND WALK = 0 THEN MENU 0

   IF CHECK = TRUE THEN
     CHECK = FALSE
     IF GROUND = 4 OR GROUND = 5 OR GROUND = 6 THEN
       CHECKEVENT
     ELSE
       IF RND(1) < .04 THEN CHECKEVENT
     END IF
   END IF

   IF BATTLERESULT = 3 THEN MENU 1

   DELAY 1

 LOOP UNTIL QUIT OR ENDING

 SCREEN , , VISPAGE, VISPAGE

 LINE (38, 18)-(105, 101), 0, BF

END SUB

