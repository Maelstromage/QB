SUB MENU (P)

 IF P = 1 THEN
   SCREEN , , MAPPAGE, VISPAGE
   GET (MAPSX, MAPSY + 40)-(MAPSX + 79, MAPSY + 79), FMV
   SCREEN , , AUXPAGE, VISPAGE
   PUT (20, 100), FMV, PSET
   SCREEN , , AUXPAGE, VISPAGE
   GET (216, 21)-(291, 40), FMV
   SCREEN , , AUXPAGE, VISPAGE
   PUT (22, 114), FMV, AND
   SCREEN , , AUXPAGE, VISPAGE
   GET (216, 0)-(291, 19), FMV
   SCREEN , , AUXPAGE, VISPAGE
   PUT (22, 114), FMV, OR
 END IF

 SCREEN , , VISPAGE, VISPAGE

 MX = 50: MY = 50: LC = 0

 LINE (MAPOUTX - 2, MAPOUTY - 2)-(MAPOUTX + MX - 2, MAPOUTY + MY - 0), 15, B
 LINE (MAPOUTX - 1, MAPOUTY - 1)-(MAPOUTX + MX - 3, MAPOUTY + MY - 1), 1, B
 LINE (MAPOUTX, MAPOUTY)-(MAPOUTX + MX - 4, MAPOUTY + MY - 2), 15, BF
 LINE (MAPOUTX, MAPOUTY + MY + 1)-(MAPOUTX + MX - 1, MAPOUTY + MY + 1), 1, B
 LINE (MAPOUTX + MX - 1, MAPOUTY - 1)-(MAPOUTX + MX - 1, MAPOUTY + MY + 1), 1, B

 BATTLERESULT = 0
 MENUUPDATE 0
 CANCEL = FALSE
 SELECTED = 0
 CURSORX = MAPOUTX + 34
 CURSORY = MAPOUTY
 CURSORP = 0
 COUNTDOWN = 10 + INT(RND(1) * 10) - ((1 \ -1) \ 2)

 WHILE INKEY$ <> "": WEND

 DO
   IF CURSORMOVE = 0 THEN
     A$ = UCASE$(INKEY$): A = RND(1): IF LEN(A$) = 2 THEN A$ = "*" + RIGHT$(A$, 1)
   END IF
   IF A$ = "*P" AND CURSORMOVE = 0 AND CURSORY < 48 THEN CURSORDIRECTION = 3: CURSORMOVE = (14 + (P = 1) * -14) \ 2: SE 3
   IF A$ = "*H" AND CURSORMOVE = 0 AND CURSORY > 20 THEN CURSORDIRECTION = 4: CURSORMOVE = (14 + (P = 1) * -14) \ 2: SE 2
   IF A$ = " " OR A$ = CHR$(13) THEN SELECTED = TRUE
   IF A$ = CHR$(27) AND P = 0 THEN SELECTED = TRUE: CANCEL = TRUE

   IF CURSORMOVE = 0 THEN
     CURSORP = 0
     MENUUPDATE (((CURSORY - 20) \ 14) + 1)
   ELSE
     CURSORP = 1
     MENUUPDATE 0
   END IF

   IF CURSORMOVE > 0 THEN
     CURSORMOVE = CURSORMOVE - 1 - (CURSORMOVE = 0)

     SELECT CASE CURSORDIRECTION
     CASE IS = 3: CURSORY = CURSORY + 2 + (CURSORY = 48)
     CASE IS = 4: CURSORY = CURSORY - 2 - (CURSORY = 20)
     END SELECT
   END IF

   PSETCURSOR CURSORX, CURSORY, CURSORP

   '- output game over -
   IF P = 1 THEN
     LC = LC + 1: IF LC >= 30 THEN LC = 0
     IF LC < 15 THEN
       SCREEN , , AUXPAGE, VISPAGE
       GET (22, 114)-(97, 133), FMV
       SCREEN , , VISPAGE, VISPAGE
       PUT (MAPOUTX + 2, MAPOUTY + 54), FMV, PSET
     ELSE
       SCREEN , , MAPPAGE, VISPAGE
       GET (202, 64)-(277, 83), FMV
       SCREEN , , VISPAGE, VISPAGE
       PUT (MAPOUTX + 2, MAPOUTY + 54), FMV, PSET
     END IF
   END IF

   DELAY 1

 LOOP UNTIL SELECTED OR CANCEL

 IF NOT CANCEL THEN
   CHOICE = ((CURSORY - 20) \ 14)
   SELECT CASE CHOICE
   CASE IS = 0: LOADDATA
   CASE IS = 1: SAVEDATA
   CASE IS = 2: QUIT = TRUE
   END SELECT
 END IF

 PSET (MAPOUTX - 1, MAPOUTY + MY - 2 + 2), 1
 PSET (MAPOUTX + MX - 2, MAPOUTY - 1), 1
 SCREEN , , MAPPAGE, VISPAGE
 GET (200, 10)-(279, 89), FMV
 SCREEN , , VISPAGE, VISPAGE
 PUT (MAPOUTX, MAPOUTY), FMV, PSET

END SUB

