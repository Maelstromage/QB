       DRAWNEWFONT BTLOUTX + 5, BTLOUTY + 12, &HD, &H0, 2, LEFT$(T2$, I)
       DELAY 1
     NEXT
   END IF
 CASE ELSE
   FOR I = 1 TO LEN(TALK1$(P2))
     DRAWNEWFONT BTLOUTX + 5, BTLOUTY + 3, TALKC(P2), &H0, 2, LEFT$(TALK1$(P2), I)
     DELAY 1
   NEXT

   IF LEN(LTRIM$(TALK2$(P2))) <> 0 THEN
     FOR I = 1 TO LEN(TALK2$(P2))
       DRAWNEWFONT BTLOUTX + 5, BTLOUTY + 12, TALKC(P2), &H0, 2, LEFT$(TALK2$(P2), I)
       DELAY 1
     NEXT
   END IF

   IF LEN(LTRIM$(TALK3$(P2))) <> 0 THEN
