 CASE IS = 0
   SCREEN , , MAPPAGE, VISPAGE
   GET (14 * P2, 166)-(14 * P2 + 12, 180), FMV
   SCREEN , , AUXPAGE, VISPAGE
   PUT (X, Y), FMV, AND
   SCREEN , , MAPPAGE, VISPAGE
   GET (14 * P2, 150)-(14 * P2 + 12, 164), FMV
   SCREEN , , AUXPAGE, VISPAGE
   PUT (X, Y), FMV, OR
 CASE IS = 1
   SCREEN , , MAPPAGE, VISPAGE
   GET (230 + 13 * P2, 170)-(241 + 13 * P2, 188), FMV
   SCREEN , , AUXPAGE, VISPAGE
   PUT (X, Y), FMV, AND
   SCREEN , , MAPPAGE, VISPAGE
   GET (230 + 13 * P2, 150)-(241 + 13 * P2, 168), FMV
   SCREEN , , AUXPAGE, VISPAGE
   PUT (X, Y), FMV, OR
 END SELECT

END SUB

