1 CLS : GOSUB STUFF: LOCATE 3, 1: PRINT "MUSIC NORMAL": LOCATE 1, 1: PRINT "QUARTER NOTES": CT = 1
2 A$ = INKEY$:
IF A$ = "D" THEN GOSUB DEMO
IF A$ = CHR$(9) THEN GOSUB CT
3 IF A$ = CHR$(27) THEN END
4 IF A$ = "1" THEN PLAY "<E>"
5 IF A$ = "2" THEN PLAY "<F>"
6 IF A$ = "3" THEN PLAY "<G>"
7 IF A$ = "4" THEN PLAY "<A>"
8 IF A$ = "5" THEN PLAY "<B>"
9 IF A$ = "6" THEN PLAY "C"
10 IF A$ = "7" THEN PLAY "D"
11 IF A$ = "8" THEN PLAY "E"
12 IF A$ = "9" THEN PLAY "F"
13 IF A$ = "0" THEN PLAY "G"
14 IF A$ = "-" THEN PLAY "A"
15 IF A$ = "=" THEN PLAY "B"
16 IF A$ = "," THEN PLAY "<"
17 IF A$ = "." THEN PLAY ">"
18 IF A$ = CHR$(8) THEN GOSUB CS
A$ = UCASE$(A$): IF A$ = "D" THEN GOSUB DEMO
19 GOTO 2
20 CS:
21 LOCATE 1, 1: PRINT "                      "
LOCATE 1, 1
22 A = A + 1
23 IF A = 8 THEN A = 1
24 IF A = 1 THEN LOCATE 1, 1: PRINT "WHOLE NOTES": PLAY "L1"
25 IF A = 2 THEN LOCATE 1, 1: PRINT "DOTTED HALF NOTES": PLAY "L2"
26 IF A = 3 THEN PRINT "HALF NOTES": PLAY "L3"
27 IF A = 4 THEN PRINT "QUARTER NOTES": PLAY "L4"
28 IF A = 5 THEN PRINT "SHORT QUARTER NOTES": PLAY "L5"
29 IF A = 6 THEN PRINT "EIGHTH NOTES": PLAY "L6"
30 IF A = 7 THEN PRINT "SIXTEENTH NOTES": PLAY "L8"
31 RETURN
32 DEMO:
33 FOR DEMO = 1 TO 20
34 RANDOMIZE TIMER
35 DEM = INT(RND(1) * 13 + 1)
36 IF DEM = 1 THEN PLAY "P6"
37 IF DEM = 2 THEN PLAY "<E>"
38 IF DEM = 3 THEN PLAY "<F>"
39 IF DEM = 4 THEN PLAY "<G>"
40 IF DEM = 5 THEN PLAY "<A>"
41 IF DEM = 6 THEN PLAY "<B>"
42 IF DEM = 7 THEN PLAY "C"
43 IF DEM = 8 THEN PLAY "D"
44 IF DEM = 9 THEN PLAY "E"
45 IF DEM = 10 THEN PLAY "F"
46 IF DEM = 11 THEN PLAY "G"
47 IF DEM = 12 THEN PLAY "A"
48 IF DEM = 13 THEN PLAY "B"
49 NEXT DEMO
50 RETURN
51 STUFF:
52 PRINT "   ALEX JORDAN'S MUSIC MAESTRO!"
53 DO: LOOP WHILE INKEY$ = ""
54 CLS : PRINT "   INSTRUCTIONS:"
55 PRINT : PRINT "   1 : LOW ``E''"
56 PRINT "   2 : LOW ``F''"
57 PRINT "   3 : LOW ``G''"
58 PRINT "   4 : LOW ``A''"
59 PRINT "   5 : LOW ``B''"
60 PRINT "   6 : REG. ``C''"
61 PRINT "   7 : REG. ``D''"
62 PRINT "   8 : REG. ``E''"
63 PRINT "   9 : REG. ``F''"
64 PRINT "   0 : REG. ``G''"
65 PRINT "   - : REG. ``A''"
66 PRINT "   = : REG. ``B''"
67 PRINT : PRINT "   D : A DEMO"
68 PRINT "   [,] : LOWER THE OCTAVE"
69 PRINT "   [.] : HIGHTEN THE OCTAVE"
70 PRINT "   [Backspace] : CHANGE LENGTH"
71 PRINT "   [Esc] : END THE PROGRAM"
PRINT "   [Tab] : CHANGE TONE (NORMAL, LEGATO, STACCATO)"
72 DO: LOOP WHILE INKEY$ = "":
73 CLS : RETURN
74 CT:
75 CT = CT + 1
76 IF CT = 4 THEN CT = 1
77 LOCATE 3, 1: PRINT "                       "
78 IF CT = 1 THEN LOCATE 3, 1: PRINT "MUSIC NORMAL": PLAY "MN"
79 IF CT = 2 THEN LOCATE 3, 1: PRINT "MUSIC LEGATO": PLAY "ML"
80 IF CT = 3 THEN LOCATE 3, 1: PRINT "MUSIC STACCATO": PLAY "MS"
81 RETURN







