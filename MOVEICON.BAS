DIM pixel(16, 16)

DIM grass%(150)
FOR y = 1 TO 16
	FOR x = 1 TO 16
		READ pixel(x, y)
		pixel(x, y) = INT(RND * 5) + 118
		LINE (x, y)-(x, y), pixel(x, y)
	NEXT x
NEXT y
GET (1, 1)-(16, 16), grass%

PUT (1, 1), grass%, PSET
DIM mountain%(150)
FOR y = 1 TO 16
	FOR x = 1 TO 16
		READ pixel(x, y)
		IF pixel(x, y) <> 999 THEN
