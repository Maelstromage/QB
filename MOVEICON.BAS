CurrentScreen = 7
XPos = 12
YPos = 5
CurrentFace = 2
CurrentTurf = 1

GOSUB DrawMap

REM GOSUB musicsub
PLAY OFF
REM ON PLAY(1) GOSUB musicsub


DO

GOSUB PutDarius

GOSUB DisplayStatus

a$ = INPUT$(1)
SOUND 7000, .05
x = XPos - 1
y = YPos - 1
GOSUB PutMapIcons




IF a$ = "4" THEN GOSUB MoveLeft
IF a$ = "6" THEN GOSUB MoveRight
IF a$ = "2" THEN GOSUB MoveDown
IF a$ = "8" THEN GOSUB MoveUp
IF a$ = "M" OR a$ = "m" THEN GOSUB ShowBirdsEye
LOOP UNTIL a$ = "q"


END

REM *************************************************************************

MoveLeft:

DesiredX = XPos - 1
DesiredY = YPos
CurrentFace = 2

GOSUB CheckPosition

IF DesiredX = 0 THEN
	XPos = 20
	CurrentScreen = CurrentScreen - 1
	GOSUB DrawMap
	RETURN
END IF

IF Map$(CurrentScreen, DesiredX, DesiredY) = "G" THEN
	XPos = DesiredX
	YPos = DesiredY
	CurrentTurf = 1
END IF
IF Map$(CurrentScreen, DesiredX, DesiredY) = "D" THEN
	XPos = DesiredX
	CurrentTurf = 2
END IF


RETURN

REM *************************************************************************

MoveRight:

DesiredX = XPos + 1
DesiredY = YPos
CurrentFace = 1

GOSUB CheckPosition

IF DesiredX = 21 THEN
	XPos = 1
	CurrentScreen = CurrentScreen + 1
	GOSUB DrawMap
	RETURN
END IF

IF Map$(CurrentScreen, DesiredX, DesiredY) = "G" THEN
	XPos = DesiredX
	CurrentTurf = 1
END IF
IF Map$(CurrentScreen, DesiredX, DesiredY) = "D" THEN
	XPos = DesiredX
	CurrentTurf = 2
END IF

RETURN

REM *************************************************************************

MoveUp:

DesiredX = XPos
DesiredY = YPos - 1
CurrentFace = 4

GOSUB CheckPosition

IF DesiredY = 0 THEN
	YPos = 10
	CurrentScreen = CurrentScreen - 3
	GOSUB DrawMap
	RETURN
END IF

IF Map$(CurrentScreen, DesiredX, DesiredY) = "G" THEN
	YPos = DesiredY
	CurrentTurf = 1
END IF
IF Map$(CurrentScreen, DesiredX, DesiredY) = "D" THEN
	YPos = DesiredY
	CurrentTurf = 2
END IF

RETURN

REM *************************************************************************

MoveDown:

DesiredX = XPos
DesiredY = YPos + 1
CurrentFace = 3

GOSUB CheckPosition

IF DesiredY = 11 THEN
	YPos = 1
	CurrentScreen = CurrentScreen + 3
	GOSUB DrawMap
	RETURN
END IF

IF Map$(CurrentScreen, DesiredX, DesiredY) = "G" THEN
	YPos = DesiredY
	CurrentTurf = 1
END IF
IF Map$(CurrentScreen, DesiredX, DesiredY) = "D" THEN
	YPos = DesiredY
	CurrentTurf = 2
END IF

RETURN

REM *************************************************************************

PutDarius:

IF CurrentTurf = 1 THEN
	IF CurrentFace = 1 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarGrasLeft%, PSET
	END IF
	IF CurrentFace = 2 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarGrasRight%, PSET
	END IF
	IF CurrentFace = 3 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarGrasDown%, PSET
	END IF
	IF CurrentFace = 4 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarGrasUp%, PSET
	END IF
END IF
IF CurrentTurf = 2 THEN
	IF CurrentFace = 1 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarDesLeft%, PSET
	END IF
	IF CurrentFace = 2 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarDesRight%, PSET
	END IF
	IF CurrentFace = 3 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarDesDown%, PSET
	END IF
	IF CurrentFace = 4 THEN
		PUT ((XPos - 1) * 16, (YPos - 1) * 16), DarDesUp%, PSET
	END IF
END IF

RETURN

REM *************************************************************************

DrawMap:

FOR y = 0 TO 9
	FOR x = 0 TO 19
		GOSUB PutMapIcons
	NEXT x
NEXT y

RETURN

REM *************************************************************************

PutMapIcons:

SELECT CASE Map$(CurrentScreen, x + 1, y + 1)
	CASE IS = "M"
		PUT (x * 16, y * 16), mountain%, PSET
	CASE IS = "G"
		PUT (x * 16, y * 16), grass%, PSET
	CASE IS = "T"
		PUT (x * 16, y * 16), trees%, PSET
	CASE IS = "W"
		PUT (x * 16, y * 16), water%, PSET
	CASE IS = "H"
		PUT (x * 16, y * 16), town%, PSET
	CASE IS = "1"
		PUT (x * 16, y * 16), towertop%, PSET
	CASE IS = "2"
		PUT (x * 16, y * 16), towerbot%, PSET
	CASE IS = "C"
		PUT (x * 16, y * 16), cave%, PSET
	CASE IS = "D"
		PUT (x * 16, y * 16), desert%, PSET
	CASE IS = "["
		PUT (x * 16, y * 16), casttoplef%, PSET
	CASE IS = "]"
		PUT (x * 16, y * 16), casttoprig%, PSET
	CASE IS = "{"
		PUT (x * 16, y * 16), castbotlef%, PSET
	CASE IS = "}"
		PUT (x * 16, y * 16), castbotrig%, PSET
	CASE ELSE
		PUT (x * 16, y * 16), grass%, PSET
END SELECT

RETURN

REM *************************************************************************

DisplayStatus:

LOCATE 21
COLOR 15: PRINT "Health:  ";
COLOR 4: PRINT DarHealth,
COLOR 15: PRINT "Gold:  ";
COLOR 14: PRINT DarGold
LOCATE 22: PRINT "               "
RETURN

REM *************************************************************************

ShowBirdsEye:

CLS

FOR BirdScreen = 1 TO 15
	FOR BirdX = 1 TO 20
		FOR BirdY = 1 TO 10
		SELECT CASE BirdScreen
			CASE IS = 1
				XAdj = 0
				YAdj = 0
			CASE IS = 2
				XAdj = 20
				YAdj = 0
			CASE IS = 3
				XAdj = 40
				YAdj = 0
			CASE IS = 4
				XAdj = 0
				YAdj = 10
			CASE IS = 5
				XAdj = 20
				YAdj = 10
			CASE IS = 6
				XAdj = 40
				YAdj = 10
			CASE IS = 7
				XAdj = 0
				YAdj = 20
			CASE IS = 8
				XAdj = 20
				YAdj = 20
			CASE IS = 9
				XAdj = 40
				YAdj = 20
			CASE IS = 10
				XAdj = 0
				YAdj = 30
			CASE IS = 11
				XAdj = 20
				YAdj = 30
			CASE IS = 12
				XAdj = 40
				YAdj = 30
			CASE IS = 13
				XAdj = 0
				YAdj = 40
			CASE IS = 14
				XAdj = 20
				YAdj = 40
			CASE IS = 15
				XAdj = 40
				YAdj = 40
		END SELECT

		SELECT CASE Map$(BirdScreen, BirdX, BirdY)
			CASE IS = "M"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 207
			CASE IS = "G"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 10
			CASE IS = "T"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 2
			CASE IS = "W"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 1
			CASE IS = "H"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 15
			CASE IS = "1"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 17
			CASE IS = "2"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 17
			CASE IS = "C"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 4
			CASE IS = "D"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 14
			CASE IS = "["
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 20
			CASE IS = "]"
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 20
			CASE ELSE
				CIRCLE (BirdX + XAdj + 130, BirdY + YAdj + 75), 0, 2
		END SELECT
		NEXT BirdY
	NEXT BirdX
NEXT BirdScreen
a$ = INPUT$(1)
CLS
GOSUB DrawMap

RETURN

CheckPosition:

IF (CurrentScreen = 1 AND DesiredX = 2 AND DesiredY = 3) THEN
	LOCATE 22: PRINT "Tower2"
ELSEIF (CurrentScreen = 2 AND DesiredX = 11 AND DesiredY = 2) THEN
	LOCATE 22: PRINT "Cave3"
ELSEIF (CurrentScreen = 3 AND DesiredX = 9 AND DesiredY = 3) THEN
	LOCATE 22: PRINT "Tower1"
ELSEIF (CurrentScreen = 2 AND DesiredX = 11 AND DesiredY = 2) THEN
	LOCATE 22: PRINT "Cave3"
ELSEIF (CurrentScreen = 7 AND DesiredX = 2 AND DesiredY = 5) THEN
	LOCATE 22: PRINT "Cave1"
ELSEIF (CurrentScreen = 7 AND DesiredX = 13 AND DesiredY = 5) THEN
	LOCATE 22: PRINT "Village1"

ELSEIF (CurrentScreen = 8 AND DesiredX = 6 AND DesiredY = 4) THEN
	LOCATE 22: PRINT "S.Cave2"
ELSEIF (CurrentScreen = 8 AND DesiredX = 15 AND DesiredY = 4) THEN
	LOCATE 22: PRINT "S.Cave1"
ELSEIF (CurrentScreen = 8 AND DesiredX = 11 AND DesiredY = 5) THEN
	LOCATE 22: PRINT "Castle"
ELSEIF (CurrentScreen = 8 AND DesiredX = 10 AND DesiredY = 5) THEN
	LOCATE 22: PRINT "Castle"
ELSEIF (CurrentScreen = 8 AND DesiredX = 4 AND DesiredY = 8) THEN
	LOCATE 22: PRINT "S.Cave4"
ELSEIF (CurrentScreen = 8 AND DesiredX = 17 AND DesiredY = 8) THEN
	LOCATE 22: PRINT "S.Cave3"
ELSEIF (CurrentScreen = 11 AND DesiredX = 12 AND DesiredY = 5) THEN
	LOCATE 22: PRINT "Cave2"
ELSEIF (CurrentScreen = 12 AND DesiredX = 7 AND DesiredY = 4) THEN
	LOCATE 22: PRINT "Cave4"
ELSEIF (CurrentScreen = 12 AND DesiredX = 9 AND DesiredY = 5) THEN
	LOCATE 22: PRINT "PassA1"
ELSEIF (CurrentScreen = 12 AND DesiredX = 5 AND DesiredY = 7) THEN
	LOCATE 22: PRINT "PassA2"

END IF
RETURN

